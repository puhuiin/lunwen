# 表1（2026-09-02 重构）：一行一指标、不合并单元格；列序为
#   指标 → 影响渠道（理论依据） → 来源 → 计算公式 → 说明（含大小值含义）
# 公式一律写到可复算的程度（含 MPPM 与 timing 的完整表达式）。
theory_rows = [
    # ---- 经理与基金背景 ----
    ['任职年限\ntenure',
     '新任经理的解雇风险对业绩更敏感，职业顾虑促使其更努力',
     'Chevalier & Ellison (1999)[11]',
     'tenure = 观测日 − 首次任职日（天）',
     '值越大表示从业越久。实证方向为负：任职越久 alpha 越低'],
    ['基金年龄\nlog_age',
     '基金存续期越长，历史包袱与既有持仓约束越强',
     'Berk & Green (2004)[12]',
     'log_age = ln(存续月数)',
     '值越大表示基金越老。实证方向为负：基金越新 alpha 越高'],
    ['基金规模\nlog_aum',
     '资金流入使规模扩大，交易成本与容量约束令超额收益递减',
     'Berk & Green (2004)[12]',
     'log_aum = ln(季度平均资产净值，亿元)',
     '值越大表示规模越大。实证方向为负：规模越小 alpha 越高'],
    ['性别\nmale',
     '男性投资者更易过度自信、交易更频繁',
     'Barber & Odean (2001)[29]',
     'male = 1(经理为男性)',
     '哑变量。三口径均不显著，未纳入画像'],
    ['CFA 资格\nhas_CFA',
     '专业资格认证是否代表可转化为业绩的技能',
     'Chevalier & Ellison (1999)[11]',
     'has_CFA = 1(经理持有 CFA)',
     '哑变量。全样本仅 9 人持证，样本过小，未纳入画像'],
    ['学历\nmaster_up',
     '教育水平作为人力资本的代理变量',
     'Chevalier & Ellison (1999)[11]',
     'master_up = 1(硕士及以上)',
     '哑变量。剔除缺失后与业绩无稳定关系，未纳入画像'],
    ['院校层次\ntop_school',
     '名校背景所含的信息网络与筛选效应',
     'Chevalier & Ellison (1999)[11]',
     'top_school = 1(本科院校属重点高校名单)',
     '哑变量。覆盖率仅 41.8%、三口径均不显著，未纳入画像'],
    # ---- 认知与行为偏差 ----
    ['风险偏好不对称\nrisk_asym',
     '风险态度随盈亏状态改变；下行风险要求额外补偿',
     'Kahneman & Tversky (1979)[1]\nAng, Chen & Xing (2006)[14]',
     'risk_asym = σ(盈利季超额收益)\n − σ(亏损季超额收益)，滚动 8 季',
     '值越大表示盈利期波动越高于亏损期，即盈时进攻、亏时防守。'
     '实证方向为正'],
    ['处置效应\nde',
     '过早卖出盈利股、长期持有亏损股的倾向有损收益',
     'Shefrin & Statman (1985)[2]\nOdean (1998)[3]',
     'de = PGR − PLR；\nPGR = 已实现盈利 ÷ (已实现盈利 + 账面盈利)，\n'
     'PLR = 已实现亏损 ÷ (已实现亏损 + 账面亏损)',
     '值越大表示越倾向售盈持亏。实证方向为负：越负（越果断止损）'
     'alpha 越高'],
    ['过度自信\noc_conf',
     '业绩向好后的自我归因偏差引发过度交易',
     'Gervais & Odean (2001)[23]\nPuetz & Ruenzi (2011)[4]',
     'oc_conf = (TO_t − TO_{t−1})\n × 1(R_{t−1} > 0)；\nTO 为换手率',
     '值越大表示盈利后加码交易越明显。实证方向为负'],
    ['追涨杀跌\nrc_mom',
     '基于近期涨幅追买的趋势外推偏差',
     'Greenwood & Shleifer (2014)[21]',
     'rc_mom = 相关系数(持仓权重变动，\n 个股前 12 个月收益)',
     '值越大表示越追逐涨幅。仅 FF3 口径显著，未纳入画像'],
    ['锚定效应\nanchor_high',
     '以历史最高价为参考点，影响买卖决策',
     '池丽旭、庄新田 (2011)[26]\nGrinblatt & Han (2005)[27]',
     'anchor_high = Σ_i w_i × (P_i,t ÷ max P_i,过去36月)',
     '值越大表示持仓越接近各自历史高点。实证方向为正'],
    ['资本利得悬垂\ncgo',
     '账面盈亏相对成本基础的位置决定卖出压力',
     'Grinblatt & Han (2005)[27]',
     'cgo = Σ_i w_i × (P_i,t − RefP_i,t) ÷ RefP_i,t；\n'
     'RefP 取过去 12 个月均价',
     '值越大表示持仓账面盈利越厚。实证方向为正'],
    ['私房钱效应\nhouse_money',
     '前期盈利后风险承担意愿上升',
     '池丽旭、庄新田 (2011)[26]',
     'house_money = 1(R_{t−1} > 0)\n × (σ_t − σ_{t−1})',
     '值越大表示盈利后加大风险暴露。FF5 口径不显著，未纳入画像'],
    ['羊群方向不对称\nbhm_shm',
     '买入羊群与卖出羊群的强度差异',
     'Wermers (1999)[18]',
     'bhm_shm = 买入羊群度 − 卖出羊群度\n（LSV 测度分方向计算）',
     '值越大表示跟买强于跟卖。三口径均不显著，未纳入画像'],
    # ---- 配置与选择 ----
    ['行业集中度\nICI',
     '行业集中押注体现私有信息，集中度更高的基金业绩更优',
     'Kacperczyk et al. (2005)[5]',
     'ICI = Σ_j (w_j − w̄_j)²；\nj 为申万 31 个一级行业，w̄ 为市场平均权重',
     '值越大表示行业配置越偏离市场、押注越集中。实证方向为正'],
    ['行业风格漂移\nISDI',
     '行业风格频繁切换抬高成本、分散信息优势',
     'Chen & Wei (2025)[15]',
     'ISDI = Σ_g |w_g,t − w_g,t−1|；\n'
     'g 为按行业 Beta 分的高/中/低弹性三组',
     '值越大表示行业弹性结构变动越频繁。实证方向为负'],
    ['改进主动份额\nAS_improved',
     '相对基准的持仓偏离度是否代表主动管理能力',
     'Cremers & Petajisto (2009)[25]\nFrazzini et al. (2016)[13]',
     'AS = ½ Σ_i |w_i,基金 − w_i,基准|\n（基准为沪深 300 成分权重）',
     '值越大表示持仓越偏离基准。符号在口径间翻转，未纳入画像'],
    # ---- 风险应对 ----
    ['调仓幅度\nARG',
     '定期披露之外的调仓操作预示未来业绩',
     'Kacperczyk et al. (2008)[6]',
     'ARG = Σ_{t∈季} |R_基金,t − Σ_i w_i,期初 R_i,t|\n（月度加总）',
     '值越大表示披露持仓无法解释的收益越多、期间操作越密。实证方向为正'],
    ['下行保护\ntiming',
     '市场下跌时主动收缩暴露的择时能力',
     'Henriksson & Merton (1981)[7]\nTreynor & Mazuy (1966)[24]',
     '先按基金做分段回归：\n'
     'ex_t = a + b·MKT_t + γ·min(0, MKT_t) + ε_t；\n'
     'timing = −γ（要求样本 ≥ 12 季）',
     'γ < 0 意味着跌市中额外下跌，取负号后 timing 越大表示'
     '跌市保护越好。实证方向为正'],
    ['收益波动率\nreturn_volatility',
     '风险承担水平本身对超额收益的解释力',
     'Brown, Harlow & Starks (1996)[28]',
     'return_volatility = σ(季度超额收益)，滚动 8 季',
     '值越大表示波动越高。三口径均显著为正，但属风险暴露而非能力，'
     '未纳入画像'],
    ['风险稳定性\nrsstab',
     '风险水平在期间是否保持稳定',
     'Brown, Harlow & Starks (1996)[28]',
     'rsstab = −|σ_4季,t − σ_4季,t−1|（滞后一期）',
     '值越大（越接近 0）表示风险水平越稳定。与收益波动率相关 −0.749，'
     '正交化后不显著，未纳入画像'],
    ['Sharpe 比率\nsharpe8',
     '单位总风险的收益转化是绩效评价的基础',
     'Sharpe (1966)[8]',
     'sharpe8 = mean(ex) ÷ σ(ex)，滚动 8 季、滞后一期；\n'
     'ex = 季度收益 − 无风险利率',
     '值越大表示总风险的收益转化效率越高。实证方向为正'],
    ['Sortino 比率\nsortino8',
     '投资者真正厌恶的是下行风险而非全部波动',
     'Sortino & Price (1994)[9]',
     'sortino8 = mean(ex) ÷ σ(ex | ex < 0)，滚动 8 季、滞后一期；\n'
     '要求窗口内亏损季 ≥ 3 且下行波动 > 1%，否则置缺失',
     '值越大表示下行风险的收益转化效率越高。实证方向为正'],
    ['抗操纵绩效测度\nmppm8',
     '传统比率可被极端风险暴露操纵，需用效用变换度量',
     'Goetzmann et al. (2007)[10]',
     'mppm8 = ln[ mean_t( ((1+R_t) ÷ (1+rf_t))^{1−ρ} ) ]\n'
     ' ÷ [ (1−ρ) × Δt ]；\nρ = 3（风险厌恶系数），Δt = 0.25（季度）',
     '值越大表示经风险厌恶调整后的效用增长越高，'
     '且不易被彩票型收益形态操纵。实证方向为正'],
    # ---- 交易执行 ----
    ['策略偏离指数\nSDI',
     '风格漂移影响基金业绩与资金流',
     'Wermers (2012)[16]',
     '先做 8 季滚动风格回归：\n'
     'R_基金 ~ 大盘成长/价值 + 小盘成长/价值四指数；\n'
     'SDI = Σ_k |β_k,t − β_k,t−1|（权重归一后）',
     '值越大表示净值层面的风格漂移越剧烈。实证方向为负'],
    ['交易趋同度\nlsv',
     '机构交易存在羊群行为；被共识买入的股票随后跑赢',
     'Lakonishok et al. (1992)[17]\nWermers (1999)[18]',
     'lsv = mean_i( |p_i,t − p̄_t| − AF_i,t )；\n'
     'p_i,t = 买入股票 i 的基金数 ÷ 交易该股的基金数，\n'
     'AF 为零羊群假设下的期望偏离',
     '值越大表示买卖方向与同业越趋同。实证方向为正'],
    ['换手率\nTO',
     '交易频率与业绩的关系',
     'Puetz & Ruenzi (2011)[4]',
     'TO = 季度双边成交额 ÷ 平均资产净值',
     '值越大表示交易越频繁。仅 FF3 口径显著，未纳入画像'],
]

caption(doc, '表 1  候选指标、理论依据与计算方式')
fill_table(doc, ['指标', '影响渠道（理论依据）', '来源', '计算（公式）', '说明与方向'],
           theory_rows, widths=[2.1, 3.4, 3.2, 4.3, 4.0], size=7,
           left_cols={0, 1, 2, 3, 4})
note(doc, '注：w 为持仓权重，σ 为标准差，TO 为换手率，R 为收益率，'
          'MKT 为市场超额收益，P 为个股价格，rf 为无风险利率，1(·) 为指示函数。'
          '「说明与方向」中的实证方向依据第二部分的检验结果；'
          '标注「未纳入画像」的指标即检验未通过、不进入后续能力计分。')

# ---------------------------------------------------------------- 3 实证检验
heading(doc, '二、实证检验', 1)

heading(doc, '（一）数据来源说明', 2)
para(doc, '本文数据来自 AKShare、东方财富与 Wind（换手率），'
          '沪深 300 指数序列用于构造相对基准的超额收益口径。'
          '检验依次使用三种因变量：基金季度收益减沪深 300 收益的简单超额、'
          'FF3 三因子调整 alpha、以及主口径 FF5 五因子调整 alpha[19]——'
          '其中国市场适用性经文献[20]检验支持。'
          '样本覆盖 2006 年三季度至 2026 年二季度共 80 个季度，'
          '其中 362 只基金存续期不短于 12 个季度，构成横截面回归样本。')

DS_CN = DS['描述统计']['中文名']
# 全部研究过指标的中文名（含未入选者与背景哑变量），供矩阵表与三因变量表使用
XCN = dict(DS_CN)
XCN.update({
    'mgr_total_tenure_v2': '任职年限', 'log_fund_age': '基金年龄', 'log_aum': '基金规模',
    'male': '性别（男=1）', 'has_CFA': 'CFA 持证', 'master_up': '硕士及以上', 'top_school': '名校毕业',
    'rc_mom': '追涨杀跌', 'anchor_high': '锚定效应', 'cgo': '资本利得悬垂',
    'house_money': '私房钱效应', 'bhm_shm': '羊群不对称', 'return_volatility': '收益波动率',
    'rsstab_lag': '风险稳定性', 'TO_wind_clean': '换手率', 'AS_improved': '改进主动份额',
})
# 全部候选指标的展示顺序（与表 1 一致）：背景连续 → 背景哑变量 → 行为指标
ALLX = (['mgr_total_tenure_v2', 'log_fund_age', 'log_aum',
         'male', 'has_CFA', 'master_up', 'top_school',
         'risk_asym', 'de', 'oc_conf', 'rc_mom', 'anchor_high', 'cgo', 'house_money', 'bhm_shm',
         'ICI', 'ISDI', 'AS_improved',
         'ARG', 'timing', 'return_volatility', 'rsstab_lag',
         'sharpe8_lag', 'sortino8_lag', 'mppm8_lag',
         'SDI', 'lsv', 'TO_wind_clean'])
_DUMMY_X = {'male', 'has_CFA', 'master_up', 'top_school'}
_L1_X = {'mgr_total_tenure_v2', 'log_fund_age', 'log_aum'}


def _uv(x, dv='ff5_alpha'):
    """候选指标 x 的基金层单变量 OLS 回归结果（无控制，t/p/n/R²）。"""
    return UV['结果'][x][dv]['裸回归']


def _tt(v):
    """带符号 t 值与显著性星号。"""
    if v is None:
        return '—'
    return f"{v['t']:+.1f}{star(v['p'])}"

# -*- coding: utf-8 -*-
# 片段：新「（二）检验结果 + （三）维度归并」，由 _splice_empirical_20260902.py 拼入主脚本。

heading(doc, '（二）检验结果', 2)

para(doc, '检验分三步进行。第一步做<b>单变量回归</b>：把表 1 中每一个候选指标——'
          '包括任职年限、规模等背景变量与性别、CFA 等哑变量——单独放入对 FF5 alpha 的回归，'
          '不预设分层、不预设显著与否，看哪些指标能独立解释超额收益。'
          '第二步做<b>因变量口径对照</b>：把因变量从相对沪深 300 的简单超额收益'
          '换成 FF3 与 FF5 多因子调整收益，检验显著性是否依赖特定基准。'
          '第三步做<b>联立回归</b>：把全部连续型指标放入同一方程，识别相互扣除后的净效应。'
          '只有在显著性检验完成之后，才把方向一致的显著指标归并为若干能力维度（本部分之三）。')

# ---------------------------------------------------------- 式（1）单变量回归
para(doc, '单变量回归采用基金层横截面 OLS，方程为：')
equation(doc,
    _sub(_run('FF5α'), _run('i')) + _run(' = ', 'p') + _run('c')
    + _run(' + ', 'p') + _sub(_run('β'), _run('k'))
    + _run(' · ', 'p') + _sub(_run('X'), _run('k,i'))
    + _run(' + ', 'p') + _sub(_run('u'), _run('i'))
    + _run('，  k = 1, 2, …', 'p'),
    align=WD_ALIGN_PARAGRAPH.CENTER)
para(doc, '其中 i 为基金下标，Y 为基金 i 全样本期的 FF5 五因子回归截距'
          '（剥离市场、规模、价值、盈利、投资五种风格暴露后的超额收益），'
          'X_k 为第 k 个候选指标的基金内时序均值（全部指标 1%/99% 缩尾，'
          '涉及业绩的指标统一滞后一期），β_k 以 HC1 异方差稳健标准误检验。'
          '每次回归只放一个指标，右端不含任何控制变量——背景变量同样是候选项，'
          '一并受检，这正是表 1 中学历、CFA 等指标得以呈现不显著结果的原因。')

# ---------------------------------------------------------- 式（2）联立回归
para(doc, '联立回归把全部连续型候选指标同时放入同一方程：')
equation(doc,
    _sub(_run('FF5α'), _run('i')) + _run(' = ', 'p') + _run('c')
    + _run(' + ', 'p')
    + _nary('∑', _run('k') + _run(' = 1', 'p'), _run('K'),
            _sub(_run('β'), _run('k')) + _run(' · ', 'p')
            + _sub(_run('X'), _run('k,i')))
    + _run(' + ', 'p') + _sub(_run('u'), _run('i')),
    align=WD_ALIGN_PARAGRAPH.CENTER)
para(doc, '联立的意义在于：指标之间相关时，β_k 是扣除同方程其余指标信息后的净效应。'
          '四个背景哑变量（性别、CFA、硕士、名校）因缺失较多不进联立，只在单变量口径考察。')

# ---------------------------------------------------------- 表 2 单变量回归矩阵
def _cell(t):
    """矩阵单元格：方向 + 显著性星号（对应用户要求的对角线示意）。"""
    if t is None:
        return ''
    s = star(t['p'])
    if not s:
        return 'n.s.'
    return ('+' if t['t'] >= 0 else '−') + s


_mx = []
for x in ALLX:
    _ub = UV['结果'][x]['ff5_alpha']['裸回归']
    _jl = UV['联立']['ff5_alpha']['系数'].get(x)
    _row = [XCN.get(x, x)]
    for y in ALLX:
        _row.append(_cell(_ub) if y is x else '')
    _row.append(f"{_jl['t']:+.1f}{star(_jl['p'])}" if _jl else '—')
    _mx.append(_row)
_mx.append(['R²'] + [f"{UV['结果'][x]['ff5_alpha']['裸回归']['r2']:.3f}" for x in ALLX]
           + [f"{UV['联立']['ff5_alpha']['r2']:.3f}"])
_mx.append(['N'] + [str(UV['结果'][x]['ff5_alpha']['裸回归']['n']) for x in ALLX]
           + [str(UV['联立']['ff5_alpha']['n'])])
caption(doc, '表 2  全部候选指标的单变量回归矩阵（每列一次回归，因变量＝FF5 alpha）')
fill_table(doc, ['指标'] + [f'({i+1})' for i in range(len(ALLX))] + ['联立'],
           _mx, widths=[1.9] + [0.50] * len(ALLX) + [0.85], size=6, left_cols={0})
note(doc, '注：第 k 列只放入第 k 个指标做一次式（1）回归，结果落在对角线单元格：'
          '「+/−」为系数方向，***、**、* 分别表示 1%、5%、10% 水平显著，n.s. 为不显著；'
          '非对角线为空。R² 行为各单变量回归的决定系数，N 行为回归样本数。'
          '「联立」列为式（2）中该指标的净效应 t 值；哑变量与个别覆盖率不足的指标不入联立，记「—」。')

# ---------------------------------------------------------- 关键因素识别段
_uv5 = lambda x: UV['结果'][x]['ff5_alpha']['裸回归']
para(doc, f"矩阵读出的第一层信息是<b>显著性沿行为含义聚团</b>。"
          f"认知与行为偏差类全部显著：处置效应（t={_uv5('de')['t']:+.1f}）、"
          f"过度自信（t={_uv5('oc_conf')['t']:+.1f}）、锚定效应（t={_uv5('anchor_high')['t']:+.1f}）、"
          f"资本利得悬垂（t={_uv5('cgo')['t']:+.1f}）；"
          f"配置选择类全部显著：行业集中度（t={_uv5('ICI')['t']:+.1f}）、"
          f"行业风格漂移（t={_uv5('ISDI')['t']:+.1f}）；"
          f"风险应对类全部显著：调仓幅度（t={_uv5('ARG')['t']:+.1f}）、"
          f"下行保护（t={_uv5('timing')['t']:+.1f}）；"
          f"风险转化三比率 t 值最高（sharpe {(_uv5('sharpe8_lag')['t']):+.1f}、"
          f"sortino {(_uv5('sortino8_lag')['t']):+.1f}、mppm {(_uv5('mppm8_lag')['t']):+.1f}）；"
          f"交易执行类显著为负/正：风格漂移（t={_uv5('SDI')['t']:+.1f}）、"
          f"交易趋同（t={_uv5('lsv')['t']:+.1f}）。"
          f"<b>不显著的一侧同样整齐</b>：换手率（t={_uv5('TO_wind_clean')['t']:+.1f}）、"
          f"改进主动份额（t={_uv5('AS_improved')['t']:+.1f}）、追涨杀跌（t={_uv5('rc_mom')['t']:+.1f}）、"
          f"羊群方向不对称（t={_uv5('bhm_shm')['t']:+.1f}），"
          f"以及除基金年龄（t={_uv5('log_fund_age')['t']:+.1f}）外的全部背景变量——"
          f"性别、硕士以上、名校毕业均不显著，CFA 虽在 FF5 口径显著"
          f"（t={_uv5('has_CFA')['t']:+.1f}）但全样本持证者仅 9 人，属小样本极端值，不足为据。"
          f"联立之后，调仓幅度（t={UV['联立']['ff5_alpha']['系数']['ARG']['t']:+.1f}）、"
          f"下行保护（t={UV['联立']['ff5_alpha']['系数']['timing']['t']:+.1f}）、"
          f"MPPM（t={UV['联立']['ff5_alpha']['系数']['mppm8_lag']['t']:+.1f}）与行业集中度"
          f"（t={UV['联立']['ff5_alpha']['系数']['ICI']['t']:+.1f}）的净效应依然稳固，"
          f"其余指标的显著性因相互吸收而回落——高相关指标只在单变量口径同台，"
          f"归并维度时须以单变量方向为准、以联立净效应为辅（见本部分之三）。")

# ---------------------------------------------------------- 表 3 三因变量对照
_dv_rows = []
for x in ALLX:
    r = UV['结果'][x]
    _dv_rows.append([XCN.get(x, x),
                     _tt(r['ex_hs300']['裸回归']),
                     _tt(r['ff3_alpha']['裸回归']),
                     _tt(r['ff5_alpha']['裸回归'])])
caption(doc, '表 3  因变量口径对照：三种超额收益度量下的单变量回归')
fill_table(doc, ['指标', '超额收益（对沪深300）', 'FF3 alpha', 'FF5 alpha'],
           _dv_rows, widths=[4.1, 4.3, 4.3, 4.3], size=8, left_cols={0})
note(doc, '注：单元格为基金层横截面 OLS 的 t 值与显著性；三列回归样本随因变量覆盖率微调'
          '（N≈352–362）。「超额收益（对沪深300）」不剔除任何因子，风格暴露全部留在残差中，仅作参照。')

para(doc, '切换因变量揭示两类信息。其一，<b>稳健真信号</b>：13 个指标在三种口径下'
          '方向与显著性完全一致（处置效应、锚定效应、资本利得悬垂、行业集中度、行业风格漂移、'
          '调仓幅度、收益波动率、风险稳定性、三比率与基金年龄），构成后续归并的主力依据。'
          f"其二，<b>风格伪信号</b>：私房钱效应在对沪深 300 口径显著"
          f"（t={UV['结果']['house_money']['ex_hs300']['裸回归']['t']:+.2f}），"
          f"换到 FF5 后降至 t={UV['结果']['house_money']['ff5_alpha']['裸回归']['t']:+.2f}——"
          '它只是风格暴露的镜像；硕士以上占比从 '
          f"t={UV['结果']['master_up']['ex_hs300']['裸回归']['t']:+.2f} "
          f"跌到 t={UV['结果']['master_up']['ff5_alpha']['裸回归']['t']:+.2f}，同理。"
          f"反方向例子是下行保护：简单超额口径仅 t={UV['结果']['timing']['ex_hs300']['裸回归']['t']:+.2f}，"
          f"剔除因子后升至 t={UV['结果']['timing']['ff5_alpha']['裸回归']['t']:+.2f}——"
          '这是被风格噪声掩盖、因子调整后浮出水面的真信号。'
          '因此，「三口径方向一致且显著」成为后续入选能力维度的门槛。')

# ---------------------------------------------------------------- （三）维度归并
heading(doc, '（三）显著指标的维度归并', 2)

para(doc, '在显著性检验完成之后，本文把通过门槛的显著指标按影响渠道归并，'
          '抽象为六个能力维度：<b>风险转化能力</b>（Sharpe、Sortino、MPPM 三比率——'
          '同为“单位风险换取收益”的效率测度）、<b>风险应对能力</b>（调仓幅度、下行保护——'
          '披露外的主动调仓与跌市防守）、<b>认知能力</b>（风险偏好不对称、处置效应、'
          '过度自信、锚定效应——四类经典行为偏差的买卖纪律）、'
          '<b>配置选择能力</b>（行业集中度、行业风格漂移）、'
          '<b>交易执行能力</b>（风格漂移、交易趋同）与<b>基本面优势</b>'
          '（任职年限、基金年龄、规模——背景维度的镜像计分）。'
          '维度归并先对每个成分做横截面 z 标准化、按表 1 的实证方向定向，再维度内等权平均：')

# 式（3）复合公式
equation(doc,
    _sub(_run('Score'), _run('d,i')) + _run(' = ', 'p')
    + _frac(_run('1', 'p'), _sub(_run('n'), _run('d')))
    + _nary('∑', _run('j ∈ d'), None,
            _sub(_run('s'), _run('j')) + _run(' · ', 'p')
            + _run('z', 'p') + _run('(', 'p') + _sub(_run('X'), _run('j,i'))
            + _run(')', 'p')),
    align=WD_ALIGN_PARAGRAPH.CENTER)
para(doc, '其中 s_j 为成分 j 的定向符号（+1/−1，取自表 1 的实证方向），'
          'z(·) 为横截面标准化，n_d 为维度 d 内有值成分的个数——缺失不填 0，'
          '因此一只“从无亏损季、算不出 Sortino”的基金不会因数据可得性被压低得分。'
          '维度内等权避免单成分主导；六维再等权复合为综合能力分。'
          '风险应对职能拆为过程应对与转化效率两维，实得 2/6≈1/3 权重'
          f"（按层加权替代方案的得分 Spearman 相关 "
          f"{MG['④_秩相关']['相关']['综合_A_vs_综合_B']['spearman']:.4f}，排序结论不变）。"
          '锚定效应并入认知维度（与处置效应、过度自信同属行为偏差族）；'
          '资本利得悬垂虽同样通过三道门槛，但与锚定效应相关 0.63，'
          '为避免维度内信息重复计分未并入，留档备索。')

para(doc, '把六个维度得分同时放入回归（主回归方程）：')
# 式（4）主回归
equation(doc,
    _sub(_run('FF5α'), _run('i')) + _run(' = ', 'p') + _run('c')
    + _run(' + ', 'p')
    + _nary('∑', _run('d') + _run(' = 1', 'p'), _run('6'),
            _sub(_run('β'), _run('d')) + _run(' · ', 'p')
            + _sub(_run('Score'), _run('d,i')))
    + _run(' + ', 'p') + _sub(_run('γ'), _run('1')) + _run(' · ', 'p')
    + _sub(_run('tenure'), _run('i'))
    + _run(' + ', 'p') + _sub(_run('γ'), _run('2')) + _run(' · ', 'p')
    + _sub(_run('log_age'), _run('i'))
    + _run(' + ', 'p') + _sub(_run('γ'), _run('3')) + _run(' · ', 'p')
    + _sub(_run('log_aum'), _run('i'))
    + _run(' + ', 'p') + _sub(_run('u'), _run('i')),
    align=WD_ALIGN_PARAGRAPH.CENTER)
para(doc, '由于六个得分均为 z 分尺度，β_d 可直接横向比较：该维度每高 1 个标准差，'
          '季度 FF5 alpha 提高 β_d×100 个百分点。联立中六维互为对方的环境变量，'
          'β_d 即扣除其余五维后的净效应——交易执行与基本面优势在联立中转为不显著，'
          '正是其信号被相关性最高的维度吸收所致（净效应消失不等于无效，单维结果见表 5）。'
          f"维度间相关最高 {max(max(v.values()) for v in CP['S2_维度相关'].values()):.3f}、"
          f"最低 {min(min(v.values()) for v in CP['S2_维度相关'].values()):.3f}，无严重共线（图 1）。")
add_figure(doc, '论文图2_维度相关热力图.png',
           '图 1  六个能力维度的两两相关系数热力图')

cp_rows = []
for d in DIM_ORDER:
