heading(doc, '3.5  两项口径稳健性检验（对应结论 F1、F2、D2、D3、Q2、D8）', 2)
para(doc, '本节回答两个对本文框架最直接的质疑：L4 拆为两维是否必要，'
          '以及转化效率维是否属于“用业绩解释业绩”。检验设计与结论见表 7，'
          '完整过程见《方法详解》§4.9、§4.10。')

_a6, _b5, _c5 = (MG['②_五分组']['A_六维'], MG['②_五分组']['B_五维_分数级'],
                 MG['②_五分组']['C_五维_成分级'])
_het = MG['③_异质性']
rb_rows = [
    ['质疑一：L4 应否合并\n回一维，使层数＝维数',
     '三套口径对照：\nA 拆分（本文）／B 分数级合并／C 成分级合并',
     f"两职能秩相关仅 {_het['spearman']:.3f}（Pearson {_het['pearson']:.3f}）；"
     f"{_het['分位差gt30']:.0%} 的基金分位差 >0.30，{_het['极端背离数']} 只极端背离；"
     f"互控时各自强显著（{_het['两职能互控']['风险应对能力']['t']:+.2f}／"
     f"{_het['两职能互控']['风险转化能力']['t']:+.2f}）\n"
     f"Q5−Q1：A {_a6['Q5_Q1']:.4f}（t={_a6['t']:.2f}，单调）／"
