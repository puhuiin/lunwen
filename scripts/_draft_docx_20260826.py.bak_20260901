heading(doc, '4.2  典型画像（对应结论 P4）', 2)
para(doc, '选取 5 名投资经理做案例分析（按经理姓名去重），覆盖全能型、风险定价型、'
          '认知纪律型、攻守转换型、基本面优势型五种正向典型画像；'
          '另设一支反例（华安策略优选·杨明）作对照，见表 11。')
_ORD_SHORT = {'基本面优势': 'L1', '认知能力': 'L2', '配置选择能力': 'L3',
              '风险应对能力': 'L4a', '风险转化能力': 'L4b', '交易执行能力': 'L5'}
arch_rows = []
for c in PT['典型画像']:
    pct = ' ／ '.join(
        f'{_ORD_SHORT[d]} {c["六维分位"][d]:.0%}'
        for d in DIM_ORDER if c['六维分位'].get(d) is not None)
    arch_rows.append([
        c['标签'].replace('：', '\n'),
        f"{c['基金简称']}\n{c['经理']}｜{c['公司']}",
        f"{c['规模亿']:.2f}",
        f"{c['ff5_alpha']:.2%}",
        f"{c['综合能力']:+.2f}\n（{c['综合能力分位']:.0%}）",
        pct])
caption(doc, '表 11  典型画像：五名正向画像 + 一名反例的六维分位')
fill_table(doc, ['形态', '基金／经理／公司', '规模\n(亿)', 'FF5\nalpha', '综合能力\n(分位)',
                 '六维分位（L1／L2／L3／L4a／L4b／L5）'],
           arch_rows, widths=[2.6, 3.8, 1.4, 1.5, 1.9, 5.8], size=7.5,
           left_cols={0, 1, 5})
note(doc, '注：分位为该经理在全样本 400 只基金中的百分位，越接近 100% 越强。'
          'L4a 为过程应对职能、L4b 为转化效率职能，同属 L4 风险应对层。')
para(doc, '五正向案例与反例给出两条读法。<b>其一，单一维度极端不必然带来高综合业绩</b>——'
          '认知纪律型（东方惠新）L2 分位 100% 而 L4a 仅 1%；攻守转换型（信澳业绩驱动）'
          'L4a 分位 99% 而 L4b 仅 1%；基本面优势型（诺德兴新趋势）L1 分位 100% 但 alpha 为负——'
          '年轻与小规模是业绩的边界条件，不是能力本身。其二，'
          '<b>全能型与风险定价型的共同点是至少三维同处高分位</b>，'
          '反例（华安策略优选）各维度全面低分位。案例为各维度极值切面、不宜外推：'
          '全样本离散度与 alpha 相关仅 '
          f'{AUD_B["相关"]["不均衡度与alpha_文本"]}'
          f'（控综合能力后 {AUD_B["相关"]["偏相关_控制综合能力_文本"]}），'
          '按离散度五等分的 alpha 亦非单调；单点分位与 alpha 相关 '
          f'{AUD_B["相关"]["最强单点分位与alpha_文本"]}。'
          '“单点突出伴随综合业绩平平”应理解为挑选机制的产物，'
          '图 3 的雷达图并列呈现六种形态。')
add_figure(doc, '论文图3_典型经理雷达图.png',
           '图 3  五名典型投资经理 + 反例（华安策略优选·杨明）的六维能力雷达图（数值为全样本百分位）',
           width_cm=15.6)

# ---------------------------------------------------------------- 5 结论
heading(doc, '5  结论', 1)
para(doc, f"本文以 {SC['基金数']} 只中国主动权益基金、{SC['季度数']} 个季度为样本，"
          '检验 L1–L5 五层行为框架下 15 个成分指标对 FF5 超额收益的预测力，'
          '并按层等权复合为六个计分维度刻画投资经理画像。主要结论有四。')
para(doc, '第一，<b>行为可以被观测，而且与业绩相关</b>。认知层（风险偏好不对称性、处置效应、'
          '过度自信）、选择层（行业集中度、行业风格漂移）与风险应对层的两个职能'
          '（调仓幅度与下行保护；抗操纵测度、Sortino、Sharpe）共四个行为维度显著解释 alpha。'
          '其中转化效率的联立系数最大，但须交代一项限定：该职能的测度本身是风险调整后业绩'
          f"指标，与因变量共享概念内核，其 {DG['D3_剔除L4b']['增量R2']:.3f} 的增量 R²"
          f"（绝对增量，占全模型 R² 的 "
          f"{DG['D3_剔除L4b']['增量R2'] / DG['D3_剔除L4b']['含L4b']['r2']:.1%}）"
          '有一部分来自定义同源；支撑其有效性的主要证据是样本外单维检验'
          f"（前半期指标预测后半期 alpha，t={DG['D2_样本外']['单维']['风险转化能力']['t']:+.2f}；"
          f'该值与表 4 中 sortino8 规格II 的 t='
          f"{spec_t('sortino8_lag', 'spec2_panel')['t']:+.2f}"
          '数值相同纯属巧合，前者为跨期的复合维度、后者为同期的单一成分，'
          '引用时须区分）。'
          '因此更准确的说法是：<b>风险使用效率具有持续性</b>。')
para(doc, '第二，<b>L1 基本面优势是边界条件而非能力</b>。它单维显著、同期联立不显著'
          f"（t={CP['S3_联立']['系数']['基本面优势']['t']:+.2f}），"
          f"样本外联立却转为显著为正（t={DG['D2_样本外']['联立']['系数']['基本面优势']['t']:+.2f}）——"
          '年轻、小规模的前期状态确实预示后期更高的 alpha，只是同期截面上信息已被行为维度'
          '完整吸收。典型个案佐证：基本面优势分位 100% 的经理 alpha 为负。'
          '与之呼应的是行为优于标签：高能力组规模更小、学历与 CFA 占比更低。'
          '须说明的是，L1 虽更宜理解为边界条件，因其在样本外检验中显著为正，'
          '仍保留在综合得分之内，但在解读时应与四个行为维度相区分。')
para(doc, '第三，<b>指标筛选须以稳健性为门槛</b>。改进主动份额在六道检验中符号翻转，'
          '换手率、追涨杀跌、风险稳定性与收益波动率因双口径不显著、覆盖率不足、'
          '与既有指标严重重合或本质是风险暴露而被剔除。'
          '裁决原则：符号在口径间翻转、显著性依赖控制变量、群体差异不显著，'
          '三条中任一成立即不入画像。')
para(doc, '第四，<b>能力得分可用于筛选与自检</b>。按综合能力五等分，FF5 alpha 由 Q1 的 '
          f"{_s4['alpha均值']['Q1最低']:.2%} 严格单调升至 Q5 的 {_s4['alpha均值']['Q5最高']:.2%}，"
          f"Q5−Q1 每季度 {_s4['Q5_Q1'] * 100:.2f} 个百分点（t={_s4['t']:.2f}）。"
          '分解：L4b 与因变量同源（仅 L4b 五等分差 '
          f'{AUD_S["组合"]["仅L4b"]["差"] * 100:.2f} pp t={AUD_S["组合"]["仅L4b"]["t"]:.2f}，'
          f'占全六维 {AUD_S["关键比值"]["L4b单独占全六维"] * 100:.0f}%）；剔 L4b 后'
          f'{AUD_S["组合"]["剔除L4b"]["差"] * 100:.2f} pp（t={AUD_S["组合"]["剔除L4b"]["t"]:.2f}）；'
          f'行为三维 {AUD_S["组合"]["纯行为L2L3L5"]["差"] * 100:.2f} pp（t={AUD_S["组合"]["纯行为L2L3L5"]["t"]:.2f}）。'
          '单指标中区分度最高的不是选股类而是下行保护系数——'
          '市场下跌时是否主动收缩暴露。')
para(doc,
    f"<b>外部效度</b>。另以 {EXT['样本量_描述']}做佐证："
    f"L3 ISDI 绩优 {EXT['ISDI_论文口径']['mean_good']:.2f} vs 绩差 {EXT['ISDI_论文口径']['mean_bad']:.2f}"
    f"（t={EXT['ISDI_论文口径']['t']:+.2f}***，ρ={EXT['ISDI_论文口径']['spearman_rho']:+.3f}）"
    f"是最稳健外部支持；L4a timing ρ=0.130 n.s.、<b>是负面证据</b>。")

# ---------- 批次③ BCD 三个候选（2026-08-30 第二十~二十二轮） BCD 写入 ----------
para(doc,
    f"<b>运气vs实力</b>。Q5−Q1 95% CI = "
    f"[{B_BCD['ff5_alpha_bootstrap']['ci_lo']*100:.2f}pp, "
    f"{B_BCD['ff5_alpha_bootstrap']['ci_hi']*100:.2f}pp]，"
    f"{B_BCD['ff5_alpha_bootstrap']['n_valid']} 次 Bootstrap 均正，"
    f"<b>不可被运气解释</b>。")
para(doc,
    f"<b>α分解</b>。RA/DE 对选股α 预测力显著"
    f"（截面t={C_BCD['截面_选股α_DV1']['risk_asym']['t']:+.2f}/"
    f"{C_BCD['截面_选股α_DV1']['de']['t']:+.2f}，"
    f"前向RA t={C_BCD['前向t→t+1_选股α']['risk_asym']['t']:+.2f}），"
    f"择时全 n.s.；<b>认知层预测力来自选股</b>。\n"
    )
para(doc,
    f"<b>异质性</b>。按规模 3 等分："
    f"小 n={D_BCD['规模_3分位']['小']['n']} Q5−Q1="
    f"{D_BCD['规模_3分位']['小']['Q5_minus_Q1']*100:+.2f}pp(t={D_BCD['规模_3分位']['小']['t_top_vs_bottom']:+.2f})，"
    f"中 n={D_BCD['规模_3分位']['中']['n']} "
    f"{D_BCD['规模_3分位']['中']['Q5_minus_Q1']*100:+.2f}pp(t={D_BCD['规模_3分位']['中']['t_top_vs_bottom']:+.2f})，"
    f"大 n={D_BCD['规模_3分位']['大']['n']} "
    f"{D_BCD['规模_3分位']['大']['Q5_minus_Q1']*100:+.2f}pp(t={D_BCD['规模_3分位']['大']['t_top_vs_bottom']:+.2f})，"
    f"均显著为正；<b>小盘最大</b>。")
para(doc, f"局限有五。数据层面三项：处置效应依赖半年度持仓快照"
          f"（观测层覆盖 {DS['成分覆盖率_观测层']['de']:.1%}、基金层 {DS['成分覆盖率']['de']:.1%}）；"
          f"严格双边换手率仅覆盖 200 只，主口径改用 Wind 集成换手率（基金层 98.5%）；"
          f"交易趋同度以持仓变动方向代理真实买卖方向；策略偏离指数（SDI）在基金层有 "
          f"{DS['成分零值占比_基金层']['SDI']:.1%} 的基金时序均值为 0，对这部分基金不具区分度；"
          f"且样本仅含存续基金，存在幸存者偏差。"
          f"方法层面两项：风险应对层两职能与因变量均存在概念同源（复合维度与 alpha 相关 "
          f"{HOM['关键对照']['L4a复合']:.3f}、{HOM['关键对照']['L4b复合']:.3f}，"
          f"过程应对的 timing 亦由收益序列估计），性质均弱于纯行为维度；"
          f"六维等权使 L4 层实得 2/6≈33.3% 权重而其余四层各 1/6，"
          f"该加权选择经稳健性检验不改变排序结论"
          f"（按层加权综合得分 Spearman 相关 "
          f"{MG['④_秩相关']['相关']['综合_A_vs_综合_B']['spearman']:.4f}），但仍需读者知晓。")

# ---------------------------------------------------------------- 参考文献
heading(doc, '参考文献', 1)
# 顺序编码制（GB/T 7714）：按正文首次引用顺序编号 [1]–[25]，不再使用底库散乱 id
ref_ids = ['1', '15', '16', '59', '30', '60', '45', '54', '53', '52', '26', '62', '55', '39', '58', '57', '34', '31', '23', '43', '63', '64', '13', '61', '28']
for _n, i in enumerate(ref_ids, 1):
    p = doc.add_paragraph()
    r = p.add_run(f'[{_n}] {REF[i]}')
    set_run(r, size=9)
    p.paragraph_format.space_after = Pt(2)
    p.paragraph_format.line_spacing = 1.15

# ---------------------------------------------------------------- 附录 A 分期稳健性
SUBQ = json.loads((OUT / '分期稳健性_2026-08-26.json').read_text(encoding='utf-8'))
heading(doc, '附录 A  分期稳健性：2020 年结构性扩张前后的队列对照', 1)
para(doc, f'样本基金数从 2019 年末的 {DS["逐年基金数"]["2019"]} 只'
          f'跃升至 2020 年末的 {DS["逐年基金数"]["2020"]} 只，主表使用全样本。'
          '为排除结论被新基金队列驱动的可能，按基金首次出现在样本中的报告期'
          '划分两个队列——老基金队列（首次报告期早于 2020 年 1 月）与新基金队列'
          '（首次报告期不早于 2020 年 1 月），分别按方程 (7) 做六维联立回归，'
          '结果见附表 A1。')
def _stars(p):
    return '***' if p < .01 else ('**' if p < .05 else ('*' if p < .1 else ''))


sub_rows = []
for lab in ['全样本', '老基金队列', '新基金队列']:
    r_ = SUBQ[lab]
    cells = []
    for d in DIM_ORDER:
        c_ = r_['系数'][d]
        cells.append(f"{c_['coef']:+.4f}\n({c_['t']:+.2f}){_stars(c_['p'])}")
    sub_rows.append([f"{lab}\n(N={r_['n']}, R²={r_['r2']:.4f})"] + cells)
caption(doc, '附表 A1  六维联立回归的队列对照（被解释变量：FF5 alpha）')
fill_table(doc, ['样本'] + [LAYER[d].replace('（转化效率）', '\n(转化)') for d in DIM_ORDER],
           sub_rows, widths=[2.6, 2.4, 2.2, 2.4, 2.4, 2.4, 2.4], size=8, left_cols={0})
note(doc, '注：括号内为 t 值，***、**、* 分别表示 1%、5%、10% 水平显著；'
          '口径与表 6 的联立模型完全一致（HC1 稳健标准误）。')
para(doc, f"两点解读。其一，<b>核心结论不由新基金队列驱动</b>：新基金队列（N={SUBQ['新基金队列']['n']}）"
          '几乎完整复刻全样本结论——认知、配置选择、风险应对、风险转化四维全部显著为正，'
          '基本面优势与交易执行不显著，R² 与全样本几乎相同。其二，<b>老基金队列须谨慎解读</b>：'
          f"该队列仅 {SUBQ['老基金队列']['n']} 只（样本期起点早于 2020 年的存续基金，"
          '本身即幸存者），小样本功效有限；认知（t=+2.72）与风险转化（t=+8.89）保持显著，'
          '配置选择转为负且不显著、风险应对失去显著性——'
          '这与老基金调仓频率天然下降、配置结构趋于稳定的行为特征一致，'
          '不宜解读为维度失效。综合两个队列，本文的核心结论（认知与风险转化是最稳定的行为'
          '业绩来源）在 2020 年前后均成立。')

REP.mkdir(exist_ok=True)
out_path = REP / '论文初稿_2026-08-26.docx'
doc.save(str(out_path))
print('saved:', out_path, out_path.stat().st_size, 'bytes')
print('paragraphs:', len(doc.paragraphs), 'tables:', len(doc.tables))
