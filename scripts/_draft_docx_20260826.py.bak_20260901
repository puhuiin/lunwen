# ---------------------------------------------------------------- 摘要与投稿要素
para(doc, '摘要', bold=True, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=False)
para(doc, '评价基金经理，市场习惯先看收益，但收益混合了能力与运气。本文以 2006–2026 年'
          '中国 400 只主动权益基金、9,974 个基金—季度观测为样本，把行为金融与主动管理文献'
          '归纳为 L1–L5 五层框架，从 15 个成分指标中得出六个计分维度，等权复合刻画投资经理'
          '行为画像。认知、配置选择与风险应对（过程应对、转化效率两职能）四个行为维度对 FF5'
          '超额收益具显著解释力；转化效率联立系数最大但与因变量共享概念内核，由样本外检验'
          '支撑有效性，定性为风险使用效率的持续性。基本面优势单维显著而同期联立不显著、'
          '样本外转为显著为正，是业绩的边界条件而非能力本身；改进主动份额经六道检验存在符号'
          '翻转被剔除。按综合能力五等分，组合超额收益由每季 0.64% 单调升至 3.77%（Q5−Q1=3.13'
          '个百分点，t=10.28），高能力组规模更小、学历与 CFA 占比更低——识别优秀投资经理'
          '要看行为而非简历与规模。除换手率需 Wind 授权外，其余均可由公开数据复算。', size=9, first_indent=False)
para(doc, '关键词：投资经理；行为画像；风险调整收益；等权复合；过度自信；规模不经济',
     bold=True, size=9, first_indent=False)
para(doc, 'JEL 分类号：G11；G12；G23', size=9, first_indent=False)
para(doc, 'What Kind of Investor Are You? A Behavioral Profile of Chinese Active Equity '
          'Fund Managers Based on a Five-Layer Behavioral Framework',
     bold=True, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=False, cn='Times New Roman')
para(doc, 'Abstract: Using a sample of 400 Chinese active equity funds (2006-2026, 9,974 '
          'fund-quarter observations), we organize behavioral finance and active management '
          'literature into a five-layer framework (L1-L5) and distill fifteen literature-based '
          'indicators into six equally-weighted scoring dimensions. Four behavioral dimensions '
          'significantly explain FF5-adjusted returns; the risk-conversion sub-function carries '
          'the largest joint coefficient but shares a conceptual kernel with the dependent '
          'variable, so its validity rests on out-of-sample tests. Fundamental advantage is a '
          'boundary condition rather than an ability: significant univariately and '
          'out-of-sample, absorbed contemporaneously. Improved Active Share is rejected after '
          'six specification tests with sign flips. Quintile portfolios sorted on composite '
          'ability yield monotonically increasing alphas (0.64% to 3.77% per quarter, '
          't=10.28), and top-ability managers run smaller funds with fewer advanced degrees. '
          'Except for turnover, which requires a licensed Wind terminal, all measures are '
          'computable from public holdings and NAV data.',
     size=9, first_indent=False, cn='Times New Roman')
para(doc, 'Keywords: fund manager; behavioral profile; risk-adjusted return; equal-weight '
          'composite; overconfidence; diseconomies of scale', size=9, first_indent=False,
     cn='Times New Roman')

# 首页脚注已按读者视角移除（2026-08-31）：内部产物与结论编号体系不再出现在论文中

# ---------------------------------------------------------------- 1 引言
heading(doc, '1  引言', 1)
para(doc, '投资经理的行为直接决定组合业绩，对自身行为特征的充分认识是改善投资、提升业绩的'
          '起点；对投资者与委托人而言，一套可检验、可复制的行为刻画方法也为业绩评价与管理人'
          '筛选提供了可操作工具。行为金融与主动管理文献已积累了成熟的测度体系：前景理论刻画'
          '风险态度的损益不对称[1]，处置效应刻画“售盈持亏”'
          '[2,3]，业绩反馈引发的过度自信导致换手放大'
          '[4,23]，行业集中度体现配置的信息优势'
          '[5]，持仓之外的主动行为可由调仓幅度捕捉'
          '[6]，择时能力可用分段回归检验[7,24]，'
          '风险向收益的转化质量有总风险、下行风险与抗操纵三类测度'
          '[8,9,10]；'
          '经理与组织层面则有职业顾虑[11]与规模不经济'
          '[12]。这些结论在成熟市场已获验证，但在中国市场是否同样成立，'
          '仍需系统检验。')
para(doc, f'本文的做法是：以 {SC["基金数"]} 只主动权益基金、{SC["起始季度"][:7]} 至 '
          f'{SC["结束季度"][:7]} 共 {SC["季度数"]} 个季度、{SC["基金季观测"]:,} 个基金—季度观测'
          f'（可进入横截面回归 {SC["可进入横截面回归的基金数"]} 只）为样本，'
          '把上述文献归纳为 L1–L5 五层行为框架，逐项检验各指标对 FF5 超额收益的解释力，'
          '再把方向与文献一致者按层等权复合为能力得分，据此刻画画像。'
          '框架为<b>五层理论层次、六个计分维度</b>——L4 风险应对层内含“过程应对”'
          '（做了什么）与“转化效率”（换回了什么）两种不同质的测度，'
          '作为测量单元须分开计分，故层数与维数不必相等（依据见 3.5）。')
para(doc, '主要发现有三。其一，认知层、选择层与风险应对层的两个职能共四个行为维度'
          '显著解释 alpha，转化效率的联立系数最大，但该职能与因变量共享“风险调整后收益”的'
          '概念内核，其有效性主要由样本外检验支撑，故定性为“风险使用效率的持续性”。'
          '其二，L1 基本面优势（新任经理、新基金、小规模）单维显著而同期联立不显著、'
          '样本外转为显著为正，它是业绩的边界条件而非能力本身。'
          '其三，改进主动份额在六道检验中符号翻转，与文献[13]的批评一致，剔除出画像。'
          '最后刻画了业绩最好与最差 5% 的群体画像，'
          '并选取 5 名正向典型画像 + 1 名反例做案例分析。')

# ---------------------------------------------------------------- 2 理论研究
heading(doc, '2  理论研究', 1)
para(doc, '本文将行为金融与主动管理文献归纳为 L1–L5 五个层次，每一层对应一条影响渠道与一组'
          '测度指标，汇总见表 1。五层分别回答五个问题：经理与组织的基本面状态如何'
          '（L1 基本面层：任职年限、基金年龄、规模的适配状态）、认知是否理性（L2 认知层）、'
          '配置是否体现信息优势（L3 选择层）、组合的行为应对与风险转化如何（L4 风险应对层，'
          '含过程应对与转化效率两职能）、交易是否遵循既定策略（L5 交易执行层）。')

# 表1 理论汇总（L1-L5）
theory_rows = [
    ['L1 基本面层\n（计分维：基本面优势）', '经验悖论：职业顾虑使新任经理更努力；规模不经济：资金流入与组织老化侵蚀 alpha（新基金效应）',
     '[11]；[12]',
     '任职年限 tenure；log 基金年龄；log 规模',
     'tenure = 观测日 − 首次任职日；log_age = ln(存续月数)；log_aum = ln(平均规模)；'
     '基本面优势 = [z(−tenure)+z(−log_age)+z(−log_aum)]/3',
     '三成分均负向（单变量 t：−1.85*/−4.13***/−1.16）；学历与 CFA 覆盖率仅 45.9%，'
    '不足以支撑稳健推断，故不进入计分（其在高能力组占比反而更低，'
    '这一反向发现留待后续研究）'],
    ['L2 认知层', '前景理论：损失域与收益域风险态度不对称；处置效应（售盈持亏）；业绩反馈引发过度自信',
     '[14]；[2]；[3]；[4]',
     '风险偏好不对称性 risk_asym；处置效应 de；过度自信 oc_conf',
     'risk_asym = σ(盈利期收益) − σ(亏损期收益)，滚动 8 季；de = PGR − PLR；'
     'oc_conf = (TO_t − TO_{t−1}) × 1(R_{t−1} > 0)',
     'risk_asym 方向与前景理论的预期相反，本文按“下行风险定价特征”理解'
    '（该解释未经独立检验），余为偏差；方向：risk_asym 正、de 与 oc_conf 负'],
    ['L3 选择层', '主动管理的信息比率渠道：行业配置偏离体现私有信息；频繁行业轮动稀释信息优势',
     '[5]；[15]',
     '行业集中度 ICI；行业风格漂移 ISDI',
     'ICI = Σ_j (w_j − w̄_j)²（申万 31 行业，归一化权重）；'
     'ISDI = Σ_g |w_g,t − w_g,t−1|（高/中/低弹性行业组权重相邻期曼哈顿距离）',
     'ICI 高为行业押注，预期正向；ISDI 高为行业轮动频繁，预期负向'],
    ['L4 风险应对层\n·过程应对职能', '未观测行为渠道：调仓幅度捕捉持仓之外的主动行为贡献；市场择时捕捉对市场状态的应对',
     '[6]；[7]',
     '调仓幅度 ARG；下行保护 timing',
     'ARG = 季度内 Σ_t |R_fund,t − Σ_i w_i R_i,t|（月度）；'
     'timing = −γ，γ 为 HM 分段回归 min(0, MKT) 项系数',
     'ARG 高为持仓外操作幅度大；timing 高为下跌市场中保护能力强'],
    ['L4 风险应对层\n·转化效率职能', '风险定价与绩效测度渠道：同样的风险承担能否转化为超额收益；抗操纵测度防止业绩粉饰',
     '[8]；[9]；[10]',
     'Sharpe 比率 sharpe8；Sortino 比率 sortino8；抗操纵测度 mppm8',
     '滚动 8 季：均值/总波动；均值/下行波动；MPPM(RHO=3)，均滞后一期',
     '三个测度均度量“上期风险转化质量”，滞后一期避免前视偏差；联立系数最大，但与因变量概念同源，依据样本外检验（见 3.5）'],
    ['L5 交易执行层', '风格纪律渠道：净值风格漂移损害投资人预期；交易趋同（羊群行为）',
     '[16]；[17]；[18]',
     '策略偏离指数 SDI；交易趋同度 lsv',
     'SDI = 风格回归（8 季滚动 OLS）相邻期权重向量的曼哈顿距离；'
     'lsv = 均值_i(|p_i − p̄_t| − AF)',
     'SDI 高为风格漂移，预期负向；lsv 实证为正，但与羊群行为的理论预期相反，'
    '本文定性为时期依存且被同层指标掩盖（见 3.4），不解释为能力。'],
]
caption(doc, '表 1  五层行为理论框架与指标体系')
fill_table(doc, ['层级', '影响渠道（理论依据）', '来源', '指标', '计算（公式）', '说明'],
           theory_rows, widths=[1.9, 3.2, 2.6, 2.4, 3.6, 3.3], size=8,
           left_cols={1, 2, 3, 4, 5})
note(doc, '注：w 为持仓权重，σ 为标准差，TO 为换手率，R 为收益率，MKT 为市场超额收益。'
          '限于篇幅，各指标的完整计算参数与逐项稳健性检验记录备索。')

# ---------------------------------------------------------------- 3 实证检验
heading(doc, '3  实证检验', 1)

heading(doc, '3.1  数据来源说明', 2)
para(doc, '数据以公开渠道为主：基金日度复权净值来自 AKShare/东方财富，用于计算季度收益与'
          '滚动绩效指标；基金定期报告的全量持仓明细（428,571 条股票级记录）用于计算行业配置、'
          '处置效应与交易趋同度；FF5 因子取自 AKShare 因子库；换手率取自 Wind 授权终端；'
          '行业分类采用申万一级（31 行业，个股匹配率 99.2%）。因变量为 Fama & French[19] '
          '五因子模型调整后的超额收益（alpha），其中国市场适用性经文献[20]检验支持。'
          '完整的数据降级链、逐文件用途与覆盖清单见《方法详解》第二节。')

heading(doc, '3.2  统计性描述（对应结论 Q1、Q3）', 2)
para(doc, f'样本覆盖 {SC["起始季度"][:7]} 至 {SC["结束季度"][:7]} 的 {SC["季度数"]} 个季度，'
          f'并非一段时期的特殊结果：基金数从 2019 年末的 {DS["逐年基金数"]["2019"]} 只'
          f'跃升至 2020 年末的 {DS["逐年基金数"]["2020"]} 只，'
          f'2021–2026 年保持 {min(DS["逐年基金数"][str(y)] for y in range(2021, 2027))}–'
          f'{max(DS["逐年基金数"][str(y)] for y in range(2021, 2027))} 只，'
          '完整覆盖 2022 年的单边下跌与 2024–2025 年的结构性行情。'
          '表 2 报告主要变量的描述统计。覆盖率须区分两个口径：'
          f'基金—季度观测层面，处置效应 {DS["成分覆盖率_观测层"]["de"]:.1%}（依赖半年度持仓快照）、'
          f'Sortino {DS["成分覆盖率_观测层"]["sortino8_lag"]:.1%}、'
          f'策略偏离指数 {DS["成分覆盖率_观测层"]["SDI"]:.1%}（滚动窗口暖机）；'
          '而本文画像与横截面回归采用基金层时序均值口径，该口径下除下行保护系数'
          f'（{DS["成分覆盖率"]["timing"]:.1%}，需至少 12 个季度）与策略偏离指数'
          f'（{DS["成分覆盖率"]["SDI"]:.1%}）外各指标均不低于 92.8%，L1 三成分为 100%。'
          '表 2 覆盖率列报告基金层口径，与第 4 节画像一致。')

DS_CN = DS['描述统计']['中文名']
DS_ST = DS['描述统计']
COV = DS['成分覆盖率']

stat_rows = []
for m in L1_ORDER + ORDER + ['ff5_adj_return', 'quarter_return']:
    cnt = DS_ST['count'].get(m)
    stat_rows.append([
        m, DS_CN_L1.get(m) or DS_CN.get(m, ''),
        f'{cnt:.0f}', fmt(DS_ST['mean'].get(m)), fmt(DS_ST['std'].get(m)),
        fmt(DS_ST['min'].get(m), 2), fmt(DS_ST['max'].get(m), 2),
        f'{COV[m]:.1%}' if m in COV else '—',
    ])
caption(doc, '表 2  主要变量描述统计（基金层时序均值，1%/99% 缩尾）')
fill_table(doc, ['变量', '中文名', 'N', '均值', '标准差', '最小值', '最大值', '覆盖率'],
           stat_rows, widths=[2.6, 3.4, 1.3, 1.9, 1.9, 1.7, 1.7, 1.6], size=8,
           left_cols={0, 1})
note(doc, '注：L1 三变量自本版起由控制变量升级为“基本面优势”计分维的成分；'
          'ff5_adj_return 为基金层 FF5 alpha（N=362 即可进入横截面回归的基金数）。'
          '覆盖率列为基金层口径（样本期内至少可算出一期即计入）。')

heading(doc, '3.3  检验手段：主要回归方程（对应结论 F3）', 2)
para(doc, '本文的因变量分两个层面：基金层 alpha（全样本期 FF5 时序回归截距）与季度层 '
          'alpha_q（FF5 时序回归的截距加残差，保留逐期信息）。自变量为各行为指标'
          '（当期值），绩效类指标（sharpe8/sortino8/mppm8）统一滞后一期，避免前视偏差。'
          '主要回归方程见表 3。')

eq_rows = [
    ['(1) 因变量·基金层', 'ex_it = α_i + β_i′F_t + e_it（F 为 FF5 因子向量，逐基金时序回归）',
     'ff5_adj_return_i = α̂_i', '≥12 个季度'],
    ['(2) 因变量·季度层', '同 (1)', 'alpha_q_it = α̂_i + ê_it（截距 + 残差）', '≥12 个季度'],
    ['(3) 择时系数', 'ex_it = a_i + b_i·MKT_t + γ_i·min(0, MKT_t) + e_it',
     'timing_i = −γ̂_i（下行保护）', '≥12 个季度'],
    ['(4) 规格I·基金层横截面',
     'ff5_adj_return_i = c + β·X̄_i + δ′Z_i + u_i（Z = 任职年限、log 基金年龄、log 规模）',
     'HC1 稳健标准误', 'N=362'],
    ['(5) 规格II·季度面板',
     'alpha_q_it = c + β·X_it + δ′Z_it + Σ_q λ_q + e_it（季度固定效应）',
     '基金层面聚类标准误', 'N=2,262（全模型）'],
    ['(6) 能力复合得分',
     '1%/99% 缩尾后 z 标准化，按理论定向，维度内等权、六维再等权；缺失成分按剩余成分取均值，不填 0',
     '综合能力得分', 'N=362'],
    ['(7) 复合得分回归', 'ff5_adj_return_i = c + Σ_d β_d·Score_d,i + u_i（六维联立，不叠加上式 Z——L1 得分即 Z 的线性组合，叠加将完全共线）',
     'HC1 稳健标准误', 'N=362'],
]
caption(doc, '表 3  主要回归方程')
fill_table(doc, ['方程', '设定', '说明/标准误', '样本'],
           eq_rows, widths=[3.0, 8.0, 3.4, 2.5], size=8, left_cols={0, 1, 2})
note(doc, '注：X̄_i 为指标在基金内的时序均值。两规格互为稳健性检验：规格I 是横截面能力排序，'
          '规格II 利用季度变异并控制季度共同冲击。规格II 一律使用 alpha_q——'
          '旧面板中 ff5_adj_return 在基金内为常数（362 只基金各仅一个取值），'
          '直接做季度回归会机械放大样本量并虚增 t 值，这正是改进主动份额结论反复的根源（见 3.4）。')

heading(doc, '3.4  检验结果（对应结论 D1、D5、D6、D7、X1、X2、X3）', 2)
para(doc, '表 4 汇总 15 个成分指标在两个规格下的单变量回归结果。'
          '15 个成分的方向全部与文献预期一致：L2 的 risk_asym 正向、de 与 oc_conf 负向；'
          'L3 的 ICI 正向、ISDI 负向；L4 的 ARG、timing 与三个转化测度正向；L5 的 SDI 负向；'
          'L1 三成分均负向（任职越短、基金越新、规模越小，alpha 越高）。'
          '显著性上，以规格 I 为主口径，L2–L5 的十二个成分全部达到 5% 水平（其中 oc_conf '
          '与 lsv 在规格 II 下不显著，因方向与规格 I 一致而保留在复合得分中）；'
          'L1 三成分中基金年龄在 1% 水平显著、'
          '任职年限在 10% 水平边际显著、规模方向一致但不显著（t=−1.16），'
          '故 L1 的显著性主要由基金年龄承载。')

sig_rows = []
LAYER_OF = {
    'mgr_total_tenure_v2': 'L1 基本面层', 'log_fund_age': 'L1 基本面层', 'log_aum': 'L1 基本面层',
    'risk_asym': 'L2 认知层', 'de': 'L2 认知层', 'oc_conf': 'L2 认知层',
    'ICI': 'L3 选择层', 'ISDI': 'L3 选择层',
    'ARG': 'L4 风险应对层', 'timing': 'L4 风险应对层',
    'mppm8_lag': 'L4 风险应对层·转化', 'sortino8_lag': 'L4 风险应对层·转化', 'sharpe8_lag': 'L4 风险应对层·转化',
    'SDI': 'L5 交易执行层', 'lsv': 'L5 交易执行层',
}
CALC_OF = {
    'mgr_total_tenure_v2': '观测日−首次任职日（天）',
    'log_fund_age': 'ln(存续月数)',
    'log_aum': 'ln(平均规模，亿元)',
    'risk_asym': 'σ(盈利期收益)−σ(亏损期收益)，滚动8季',
    'de': 'PGR−PLR（Odean 1998）',
    'oc_conf': 'ΔTO_t×1(R_{t−1}>0)',
    'ICI': 'Σ_j(w_j−w̄_j)²，申万31',
    'ISDI': '行业组权重相邻期曼哈顿距离',
    'ARG': '季度内月度调仓偏离绝对值之和',
    'timing': '−γ（HM 分段回归）',
    'mppm8_lag': 'MPPM(RHO=3)，滚动8季，滞后一期',
    'sortino8_lag': '均值/下行波动，滚动8季，滞后一期',
    'sharpe8_lag': '均值/总波动，滚动8季，滞后一期',
    'SDI': '风格回归权重相邻期曼哈顿距离',
    'lsv': '均值_i(|p_i−p̄_t|−AF)',
}
MEANING_OF = {
    'mgr_total_tenure_v2': '经验悖论：任职越久 alpha 越低',
    'log_fund_age': '新基金效应：基金越新 alpha 越高',
    'log_aum': '规模不经济：规模越小 alpha 越高',
    'risk_asym': '盈时进攻、亏时防守的波动不对称',
    'de': '处置效应越强（售盈持亏），alpha 越低',
    'oc_conf': '业绩变好后换手放大（过度自信），alpha 越低',
    'ICI': '行业集中押注体现配置信息优势，alpha 越高',
    'ISDI': '行业风格轮动越频繁，alpha 越低',
    'ARG': '持仓外操作幅度越大，alpha 越高',
    'timing': '下跌市场中的保护能力越强，alpha 越高',
    'mppm8_lag': '抗操纵风险调整业绩越好，alpha 越高（单指标 t 最高，但概念同源，见 3.5）',
    'sortino8_lag': '下行风险转化质量越好，alpha 越高',
    'sharpe8_lag': '总风险转化质量越好，alpha 越高',
    'SDI': '净值风格漂移越大，alpha 越低',
    'lsv': '交易趋同为正向（与羊群理论预期相反，定性为时期依存＋被同层掩盖）',
}
for m in L1_ORDER:
    c1 = CP['S1_成分定向'][m]
    sig_rows.append([LAYER_OF[m], f"{m}\n{DS_CN_L1[m]}", CALC_OF[m],
                     f"t={c1['t']:+.2f}{star(c1['p'])}（单变量）",
                     '—（控制层，并入规格I）', MEANING_OF[m]])
for m in ORDER:
    s1 = spec_t(m, 'spec1_cross_section')
    s2 = spec_t(m, 'spec2_panel')
    if m == 'timing':
        c1 = CP['S1_成分定向'][m]
        txt1 = f"t={c1['t']:+.2f}{star(c1['p'])}（n={c1['n']}）"
        txt2 = '—（年度回归，并入规格I）'
    else:
        txt1 = f"t={s1['t']:+.2f}{star(s1['p'])}" if s1 else '—'
        txt2 = f"t={s2['t']:+.2f}{star(s2['p'])}" if s2 else '—'
    sig_rows.append([LAYER_OF[m], f"{m}\n{DS_CN.get(m, '')}", CALC_OF[m], txt1, txt2, MEANING_OF[m]])
caption(doc, '表 4  指标汇总表：各层次指标的显著性结果（单变量回归）')
fill_table(doc, ['层级', '指标', '计算（公式）', '规格I（横截面）', '规格II（面板）', '代表意义'],
           sig_rows, widths=[1.9, 2.4, 3.3, 2.2, 2.2, 4.9], size=7.5,
           left_cols={0, 1, 2, 5})
note(doc, '注：***、**、* 分别表示 1%、5%、10% 水平显著。L1 三成分即控制变量组，其规格I 为'
          '单变量回归（自我控制无意义）；L2–L5 成分的规格I 均含三控制变量。'
          'timing 为 Henriksson-Merton 分段回归系数，并入规格I 报告。'
          '四项指标经检验后剔除：改进主动份额（符号翻转，见表 5）、换手率（双口径不显著）、'
          '追涨杀跌（覆盖率 53.5%）、风险稳定性（与收益波动率相关 −0.749，正交化后不显著）；'
          '逐项检验记录见《方法详解》§4.11。'
          '规格I 为基金层横截面、规格II 为季度面板，两者均为<b>同期</b>口径，'
          '与 3.5 节的跨期样本外检验并不同源：'
          f"sortino8 规格II 的 t={spec_t('sortino8_lag', 'spec2_panel')['t']:+.2f} 与 3.5 节"
          f"样本外单维 t={DG['D2_样本外']['单维']['风险转化能力']['t']:+.2f} 数值相同纯属巧合，"
          '前者为同期单一成分、后者为跨期复合维度，引用时须区分。')

para(doc, '改进主动份额（AS_improved）此前结论冲突，须专门裁决。'
          '用六道检验：前五道为回归口径（表 5 前五行），第六道为群体画像的组间差异'
          '（表 5 末行）。结果是符号在口径间翻转——基金层横截面的单变量与加控制均不显著、'
          '全模型显著为负，而季度面板单变量显著为正。三条证据支持剔除：符号不稳健；'
          '显著性依赖是否控制规模与年龄，说明它捕捉的是规模效应而非主动程度；'
          f'群体画像中两组差值仅 {PT["群体画像"]["原始指标"]["差值"]["AS_improved"]:+.4f}'
          f'（t={PT["群体画像"]["原始指标"]["t"]["AS_improved"]:+.2f}，'
          f'p={PT["群体画像"]["原始指标"]["p"]["AS_improved"]:.4f}）。'
          '补充的非线性与条件效应检验同样不支持'
          '（加入全部行为指标后二次项与交互项均失去显著性）。'
          '这与文献[13]一致：控制基准后主动份额不具预测力，文献[25]则持相反意见。'
          '注：口径 II 因 listwise 删除损失约 74% 样本，不宜与规格 I 直接比较。')

para(doc, '为扩充 L2 认知层，另检验两类文献驱动的偏差候选（结论 X3）：'
          '趋势外推偏差（持仓加权个股 12 月动量）[21]与有限关注度'
          '（持仓加权个股上月｜收益｜）[22]。二者基金层覆盖率均达 100%，'
          f'但方向检验均未通过——趋势外推 t=+{G4["extrap"]["t"]:.2f}（p={G4["extrap"]["p"]:.4f}）、'
          f'有限关注 t=+{G4["attn"]["t"]:.2f}（p={G4["attn"]["p"]:.4f}），均正向显著，'
          '与“偏差损害业绩”的预期负号相反，表明高 alpha 基金反而更多持有动量或极端收益个股。'
          '故二者被诚实剔除并保留检验记录，L2 维持风险不对称、处置效应、过度自信三成分；'
          '另两批扩展检验——L3 的 Brinson 分解（D9）与择时二次项、特质波动（X4）——'
          '同样未改变六维构成，详见《方法详解》。')

as_rows = []
for k, v in R3['AS_five_specs'].items():
    c = v['coef']['AS_improved']
    as_rows.append([k, v.get('n', '—'), fmt(c['b']), f"{c['t']:+.2f}{star(c['p'])}",
                    fmt(v.get('r2'))])
_ag = PT['群体画像']['原始指标']
as_rows.append(['VI_群体画像_Top5%减Bottom5%', f"{PT['群体画像']['n_each']}+{PT['群体画像']['n_each']}",
                fmt(_ag['差值']['AS_improved']),
                f"{_ag['t']['AS_improved']:+.2f}{star(_ag['p']['AS_improved'])}", '—'])
caption(doc, '表 5  改进主动份额（AS_improved）六道检验')
fill_table(doc, ['口径', 'N', '系数', 't 值', 'R²'], as_rows,
           widths=[6.0, 2.6, 2.8, 2.8, 2.6], size=8.5, left_cols={0})

para(doc, '在指标检验基础上，本文按方程 (6)(7) 构造复合得分并回归：L1、L2、L3、L5 各计一维，'
          'L4 按过程应对与转化效率两职能各计一维，共六个计分维度。'
          '表 6 显示，六维单独进入时全部显著为正；联立后 L4 转化效率系数最大'
          f'（{CP["S3_联立"]["系数"]["风险转化能力"]["coef"]:.5f}，'
          f't={CP["S3_联立"]["系数"]["风险转化能力"]["t"]:.2f}），'
          f'L5 交易执行不显著（t={CP["S3_联立"]["系数"]["交易执行能力"]["t"]:.2f}）——'
          f'其与 L4 过程应对维度相关 {CP["S2_维度相关"]["交易执行能力"]["风险应对能力"]:.3f}、'
          f'成分层面 SDI 与 ARG 相关达 {CH["关键跨层相关"]["ARG_x_SDI"]:+.2f}，信息被吸收；'
          f'L1 单维显著（t={CP["S3_单维"]["基本面优势"]["t"]:.2f}）而联立不显著'
          f'（t={CP["S3_联立"]["系数"]["基本面优势"]["t"]:.2f}），'
          f'它与风险应对（{CP["S2_维度相关"]["基本面优势"]["风险应对能力"]:.3f}）、'
          f'交易执行（{CP["S2_维度相关"]["基本面优势"]["交易执行能力"]:.3f}）高度重叠，'
          '说明规模与年龄的作用主要经由行为维度传导。维度间相关最高 0.589、最低 0.183，'
          '无严重共线，图 2 的热力图给出了六个维度两两相关的全貌。')
add_figure(doc, '论文图2_维度相关热力图.png',
           '图 2  六个计分维度的两两相关系数热力图')

cp_rows = []
for d in DIM_ORDER:
    u = CP['S3_单维'][d]
    j = CP['S3_联立']['系数'][d]
    cp_rows.append([LAYER[d], fmt(u['coef']), f"{u['t']:.2f}{star(u['p'])}", fmt(u['r2'], 4),
                    fmt(j['coef']), f"{j['t']:.2f}{star(j['p'])}"])
u = CP['S3_单维']['综合能力']
