caption(doc, '表 6  能力复合得分对 FF5 alpha 的回归（方程 7）')
fill_table(doc, ['维度', '单维系数', '单维 t', '单维 R²', '联立系数', '联立 t'],
           cp_rows, widths=[3.6, 2.6, 2.4, 2.4, 2.6, 2.4], size=8.5, left_cols={0})
note(doc, f"注：联立模型 N={CP['S3_联立']['n']}，R²={CP['S3_联立']['r2']:.4f}，"
          '不叠加控制变量（L1 得分是三控制变量的线性组合，叠加即完全共线）；'
          f"对照口径“五维联立＋三控制变量”R²={CP['S3_联立_五维对照']['r2']:.4f}，信息含量相当。"
          'L2–L5 单维回归含三控制变量与 HC1 稳健标准误，L1 单维为无控制变量回归。')

_s4 = CP['S4_分组']
para(doc, f"分组检验进一步验证单调性：按综合能力五等分组，FF5 alpha 从 Q1 的 "
          f"{_s4['alpha均值']['Q1最低']:.2%} 单调升至 Q5 的 {_s4['alpha均值']['Q5最高']:.2%}"
          f"（季度均值），Q5−Q1 差 {_s4['Q5_Q1'] * 100:.2f} 个百分点（t={_s4['t']:.2f}）；"
          f"季度原始收益同样严格单调（{_s4['季度收益均值']['Q1最低']:.2%} → "
