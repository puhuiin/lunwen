    dim_rows.append([LAYER[d], fmt(GP['六维']['Top5%'][d]), fmt(GP['六维']['Bottom5%'][d]),
                     fmt(diff), f'{t:+.2f}{star(p)}'])
caption(doc, '表 5  群体画像：Top5% 与 Bottom5% 的能力维度差异')
fill_table(doc, ['能力维度', 'Top5% 均值', 'Bottom5% 均值', '差值', 't 值'],
           dim_rows, widths=[4.6, 3.2, 3.2, 3.0, 3.0], size=8.5, left_cols={0})
note(doc, '注：单指标中区分度最高的是下行保护系数'
          f"（t={GP['原始指标']['t']['timing']:+.2f}）——最能拉开差距的行为不是选股，"
          '而是市场下跌时是否主动收缩暴露；其余显著分化的原始指标明细备索。')

bg_rows = []
for i, q in enumerate(['Q1最低', 'Q2', 'Q3', 'Q4', 'Q5最高']):
    _pa = PA['五分组'][q]
    bg_rows.append([f'Q{i+1}', f"{BF['n'][q]}", fmt(BF['综合能力'][q]),
                    f"{BF['ff5_alpha'][q]:.2%}", f"{BF['季度收益'][q]:.2%}",
                    f"{BF['规模亿'][q]:.1f}", f"{_pa['背景覆盖率']:.0%}",
                    f"{_pa['硕士以上_有效分母']:.0%}",
                    f"{_pa['CFA_有效分母']:.0%}"])
caption(doc, '表 6  综合能力五分组背景（Q1 最低 → Q5 最高）')
fill_table(doc, ['分组', 'N', '综合能力', 'FF5 alpha', '季度收益', '规模(亿)',
                 '背景覆盖', '硕士以上', 'CFA'],
           bg_rows, widths=[1.5, 1.3, 2.2, 2.2, 2.2, 2.0, 1.9, 1.9, 1.8], size=8.5)
note(doc, '注：规模为组内中位数（均值受少数巨型基金影响）。'
          '背景覆盖为该组学历／CFA 数据可得比例；'
          '硕士以上与 CFA 占比以该组有效样本为分母，'
          '不将缺失计入非持有——因覆盖率本身与能力得分显著负相关，'
          '按全组人数为分母会产生学历随能力下降的假趋势。')

heading(doc, '（二）典型画像', 2)
para(doc, '选取 5 名投资经理做案例分析（按经理姓名去重），覆盖全能型、风险定价型、'
          '认知纪律型、攻守转换型、基本面优势型五种正向典型画像，'
          '另设一支反例（华安策略优选·杨明）作对照，见表 7 与图 3。')
_ORD_SHORT = {'基本面优势': 'L1', '认知能力': 'L2', '配置选择能力': 'L3',
              '风险应对能力': 'L4a', '风险转化能力': 'L4b', '交易执行能力': 'L5'}
arch_rows = []
for c in PT['典型画像']:
    pct = ' ／ '.join(
        f'{_ORD_SHORT[d]} {c["六维分位"][d]:.0%}'
        for d in DIM_ORDER if c['六维分位'].get(d) is not None)
    arch_rows.append([
        c['标签'].replace('：', '\n'),
        f"{c['基金简称']}\n{c['经理']}｜{c['公司']}",
        f"{c['规模亿']:.2f}",
        f"{c['ff5_alpha']:.2%}",
        f"{c['综合能力']:+.2f}\n（{c['综合能力分位']:.0%}）",
        pct])
caption(doc, '表 7  典型画像：五名正向画像 + 一名反例的六维分位')
fill_table(doc, ['形态', '基金／经理／公司', '规模\n(亿)', 'FF5\nalpha', '综合能力\n(分位)',
                 '六维分位（L1／L2／L3／L4a／L4b／L5）'],
           arch_rows, widths=[2.6, 3.8, 1.4, 1.5, 1.9, 5.8], size=7.5,
           left_cols={0, 1, 5})
note(doc, '注：分位为该经理在全样本 400 只基金中的百分位，越接近 100% 越强。'
          'L4a 为过程应对、L4b 为转化效率，同属 L4 风险应对层。')
para(doc, '案例给出两条读法。其一，单一维度极端不必然带来高综合业绩：'
          '认知纪律型（东方惠新）L2 分位 100% 而 L4a 仅 1%，'
          '攻守转换型（信澳业绩驱动）L4a 分位 99% 而 L4b 仅 1%，'
          '基本面优势型（诺德兴新趋势）L1 分位 100% 但 alpha 为负——'
          '年轻与小规模是业绩的边界条件，不是能力本身。'
          '其二，全能型与风险定价型的共同点是至少三维同处高分位，'
          '反例各维度全面低分位。案例为各维度极值切面，不宜外推。')
add_figure(doc, '论文图3_典型经理雷达图.png',
           '图 3  五名典型投资经理 + 反例（华安策略优选·杨明）的六维能力雷达图（数值为全样本百分位）',
           width_cm=17.0)

# ---------------------------------------------------------------- 3(三) 结论
heading(doc, '（三）结论', 2)
para(doc, f"本文以 {SC['基金数']} 只中国主动权益基金、{SC['季度数']} 个季度为样本，"
          '检验五层行为框架下 15 个成分指标对 FF5 超额收益的预测力，'
          '并按层等权复合为六个计分维度刻画投资经理画像。主要结论有四。')
para(doc, '第一，<b>行为可以被观测，而且与业绩相关</b>。认知层、选择层与风险应对层'
          '共四个行为维度显著解释 alpha，其中风险使用效率具有持续性'
          '（其测度与因变量概念同源，故以持续性而非同期解释力表述）。')
para(doc, '第二，<b>L1 基本面优势是边界条件而非能力</b>：单维显著、同期联立不显著'
          f"（t={CP['S3_联立']['系数']['基本面优势']['t']:+.2f}），"
          f"样本外联立转为显著为正（t={DG['D2_样本外']['联立']['系数']['基本面优势']['t']:+.2f}）——"
          '年轻、小规模预示后期更高 alpha，同期信息已被行为维度吸收；'
          '因其样本外显著，仍保留在综合得分内，但解读时应与行为维度相区分。')
para(doc, '第三，<b>指标筛选须以稳健性为门槛</b>：符号在口径间翻转、显著性依赖控制变量、'
          '群体差异不显著，任一成立即不入画像——改进主动份额与换手率等四项指标因此剔除。')
para(doc, '第四，<b>能力得分可用于筛选与自检</b>：按综合能力五等分，FF5 alpha 由 Q1 的 '
          f"{_s4['alpha均值']['Q1最低']:.2%} 严格单调升至 Q5 的 {_s4['alpha均值']['Q5最高']:.2%}，"
          f"Q5−Q1 每季度 {_s4['Q5_Q1'] * 100:.2f} 个百分点（t={_s4['t']:.2f}），"
          f"剔除与因变量同源的 L4b 后纯行为三维分组差仍显著"
          f"（{AUD_S['组合']['纯行为L2L3L5']['差'] * 100:.2f} pp，"
          f"t={AUD_S['组合']['纯行为L2L3L5']['t']:+.2f}）。"
          '样本仅含存续基金，存在幸存者偏差。')

# ---------------------------------------------------------------- 参考文献
heading(doc, '参考文献', 1)
# 顺序编码制（GB/T 7714）：按正文首次引用顺序编号 [1]–[25]，不再使用底库散乱 id
ref_ids = ['1', '15', '16', '59', '30', '60', '45', '54', '53', '52', '26', '62', '55', '39', '58', '57', '34', '31', '23', '43', '63', '64', '13', '61', '28']
for _n, i in enumerate(ref_ids, 1):
    p = doc.add_paragraph()
    r = p.add_run(f'[{_n}] {REF[i]}')
    set_run(r, size=9)
    p.paragraph_format.space_after = Pt(2)
    p.paragraph_format.line_spacing = 1.15

REP.mkdir(exist_ok=True)
out_path = REP / '论文初稿_2026-08-31.docx'
doc.save(str(out_path))
print('saved:', out_path, out_path.stat().st_size, 'bytes')
print('paragraphs:', len(doc.paragraphs), 'tables:', len(doc.tables))
