theory_rows, theory_merges, metric_merges = [], [], []
for b in theory_blocks:
    r0 = len(theory_rows)
    for mname, src in b['pairs']:
        r = len(theory_rows)
        if mname == '' and r > 0:
            metric_merges.append((r - 1, r))   # 指标名跨两行：与上一行合并
        theory_rows.append([
            b['layer'] if r == r0 else '',
            b['channel'] if r == r0 else '',
            mname, src,
            b['calc'] if r == r0 else '',
            b['note'] if r == r0 else ''])
    r1 = len(theory_rows) - 1
    for col in (0, 1, 4, 5):
        theory_merges.append((col, r0, r1))

caption(doc, '表 1  五层行为理论框架与指标体系')
t1 = fill_table(doc, ['层级', '影响渠道（理论依据）', '指标', '来源', '计算（公式）', '说明'],
                theory_rows, widths=[1.4, 3.1, 2.0, 3.6, 3.2, 3.3], size=7.5,
                left_cols={0, 1, 2, 3, 4, 5})
for col, r0, r1 in theory_merges:
    if r0 == r1:
        continue
    m = t1.cell(r0 + 1, col).merge(t1.cell(r1 + 1, col))
    for p in list(m.paragraphs[1:]):
        if not p.text.strip():
            p._element.getparent().remove(p._element)
    m.vertical_alignment = WD_ALIGN_VERTICAL.CENTER
for r_prev, r_cur in metric_merges:
    m = t1.cell(r_prev + 1, 2).merge(t1.cell(r_cur + 1, 2))
    for p in list(m.paragraphs[1:]):
        if not p.text.strip():
            p._element.getparent().remove(p._element)
    # 顶对齐：指标名首行与第一位作者平齐，第二行对齐第二位作者
    m.vertical_alignment = WD_ALIGN_VERTICAL.TOP
note(doc, '注：w 为持仓权重，σ 为标准差，TO 为换手率，R 为收益率，MKT 为市场超额收益。'
          '同一指标有两位来源作者时，指标名跨两行，与右侧上下两位作者对齐。'
          '限于篇幅，各指标的完整计算参数与逐项稳健性检验记录备索。')

