# -*- coding: utf-8 -*-
"""核心结论单一数据源（2026-08-26）
================================================================================
问题：论文 docx、方法详解 HTML、画像 HTML 三个产物各自手写结论句，
数字虽然都读自 output/ JSON，但「怎么说」是分散的，改一处容易漏两处。

做法：把全部核心结论抽成一份 JSON——每条结论含
    id        稳定编号，供三产物交叉引用
    维度/主题
    定性       一句话结论（三产物必须一致的表述内核）
    证据       支撑数字（从 output/ 定稿 JSON 读取，不手写）
    限定       必须同时交代的限定条件（可为空）
    出处       该结论在三产物中各自的章节位置
三个产物的生成脚本统一 import 这份 JSON 渲染结论句，
从此「改结论」只需改一处。

输出：output/核心结论_定稿_2026-08-26.json
"""
import json
import os
import io

BASE = r'd:\Desktop\基金经理行为分析研究'
OUT = os.path.join(BASE, 'output')
TODAY = '2026-08-26'


def rj(name):
    with io.open(os.path.join(OUT, name), encoding='utf-8') as f:
        return json.load(f)


IMP = rj('指标改进_2026-08-27.json')          # 指标扩展检验（捕获率 + L2 候选）
G4 = IMP['新指标4门槛']
RV = IMP['复合重验']


CP = rj(f'六维复合定稿验证_含L1_{TODAY}.json')
PT = rj(f'画像_群体与典型_{TODAY}.json')
MG = rj(f'L4合并可行性检验_{TODAY}.json')
DG = rj(f'L4b机械性诊断_{TODAY}.json')
# L4a 概念同源诊断（2026-08-29 补做）：timing 亦由收益序列估计，需与 L4b 同等披露
HOM = rj('L4a同源诊断_2026-08-29.json')
# 构建链条诊断（2026-08-29 补做）：成分级跨层相关、ARG 绝对值检验、risk_asym 方向检验
CH = rj('构建链条诊断_2026-08-29.json')
R3 = rj(f'主回归_v3_{TODAY}.json')
DS = rj(f'统计性描述_{TODAY}.json')

S1, S2, S3, S3J, S4 = (CP['S1_成分定向'], CP['S2_维度相关'], CP['S3_单维'],
                       CP['S3_联立'], CP['S4_分组'])
GP = PT['群体画像']
BG = PT['能力五分组背景']
ARCH = PT['典型画像']
DIM6 = ['基本面优势', '认知能力', '配置选择能力', '风险应对能力',
        '风险转化能力', '交易执行能力']
LAYER_OF = {'基本面优势': 'L1', '认知能力': 'L2', '配置选择能力': 'L3',
            '风险应对能力': 'L4a', '风险转化能力': 'L4b', '交易执行能力': 'L5'}
_l1_arch = [c for c in ARCH if '基本面优势' in c['标签']][0]
_l4_arch = [c for c in ARCH if '风险应对' in c['标签']][0]

C = []


def add(cid, topic, verdict, evidence, caveat='', where=''):
    C.append(dict(id=cid, 主题=topic, 定性=verdict, 证据=evidence,
                  限定=caveat, 出处=where))


# ---------------- 框架层结论 ----------------
add('F1', '框架口径',
    '本文是五层理论框架、六个计分维度：层次回答“行为发生在哪个环节”，'
    '计分维度是要求内部指标同质、可等权平均的测量单元，二者不必一一对应。'
    'L4 风险应对层内含两种不同质的测度，故拆为 L4a 过程应对与 L4b 风险转化两维。',
    f"实测三套口径：拆分（本文）联立 R²={S3J['r2']:.4f}、"
    f"分数级合并 R²={MG['①_联立回归']['B_五维_分数级合并']['r2']:.4f}、"
    f"成分级合并 R²={MG['①_联立回归']['C_五维_成分级合并']['r2']:.4f}",
    f"六维等权使 L4 层实得 2/6≈33.3% 权重、其余四层各 1/6。"
    f"稳健性：按层加权口径（L4 恰为 1/5）与本文口径的综合分 Spearman "
    f"相关 {MG['④_秩相关']['相关']['综合_A_vs_综合_B']['spearman']:.4f}，"
    f"Top5% 名单重叠 {MG['④_秩相关']['名单重叠']['综合_A_vs_综合_B']['top重叠']}/"
    f"{MG['④_秩相关']['名单重叠']['综合_A_vs_综合_B']['n_each']}，排序结论不受影响。",
    '论文 3.5 之一 ｜ 方法详解 §4.9 ｜ 画像 3.7')

add('F2', 'L4 不合并的依据',
    'L4 两个职能测的不是一件事，合并会掩盖异质性并降低区分度，故不合并。',
    f"两职能 Spearman 秩相关 {MG['③_异质性']['spearman']:.3f}"
    f"（Pearson {MG['③_异质性']['pearson']:.3f}）；"
    f"{MG['③_异质性']['分位差gt30']:.0%} 的基金分位差 >0.30，"
    f"{MG['③_异质性']['分位差gt50']:.0%} >0.50，"
    f"{MG['③_异质性']['极端背离数']} 只极端背离；"
    f"两者互控时各自强显著（过程 t={MG['③_异质性']['两职能互控']['风险应对能力']['t']:+.2f}、"
    f"转化 t={MG['③_异质性']['两职能互控']['风险转化能力']['t']:+.2f}）；"
    f"合并后 Q5−Q1 由 {MG['②_五分组']['A_六维']['Q5_Q1']:.4f} 降至 "
    f"{MG['②_五分组']['B_五维_分数级']['Q5_Q1']:.4f}，且 alpha 五分组不再严格单调",
    f"典型个案：攻守转换型经理（{_l4_arch['基金简称']}）过程应对分位 "
    f"{_l4_arch['六维分位']['风险应对能力']:.1%}、风险转化分位 "
    f"{_l4_arch['六维分位']['风险转化能力']:.1%}，合并后该信息消失。",
    '论文 3.5 之一 ｜ 方法详解 §4.9 ｜ 画像 3.7')

add('F3', '等权复合的理由',
    '维度内与维度间均等权，不用回归赋权：回归权重会被样本期行情牵动，'
    '换窗口即变；等权可复现、不过拟合，避免把单指标的样本内噪声放大成能力。',
    '复合公式：维度得分 = Σ z(成分) / 有效成分个数（缺失成分按剩余成分取均值，不填 0）',
    'PCA 权重敏感性检验：综合分与等权口径 ρ=0.895',
    '论文 3.3 ｜ 方法详解 §4.7 ｜ 画像 1.3')

# ---------------- 维度层结论 ----------------
add('D1', '六维总体有效性',
    '六个计分维度单独进入回归时全部显著为正，综合得分能区分业绩。',
    f"单维 t 值区间 {min(S3[d]['t'] for d in DIM6):+.2f} 至 "
    f"{max(S3[d]['t'] for d in DIM6):+.2f}；"
    f"综合能力单维 t={S3['综合能力']['t']:+.2f}，R²={S3['综合能力']['r2']:.4f}；"
    f"五分组 alpha 严格单调 {S4['alpha均值']['Q1最低']:.2%} → "
    f"{S4['alpha均值']['Q5最高']:.2%}，Q5−Q1={S4['Q5_Q1']:.4f}（t={S4['t']:.2f}）",
    '', '论文 3.4／5 ｜ 方法详解 §5.4 ｜ 画像 3.5／五')

add('D2', 'L4b 风险转化',
    '联立系数最大，但该维度与因变量共享“风险调整后收益”概念内核，'
    '故定性为“风险使用效率具有持续性”，而非笼统的“最重要的能力”。',
    f"联立 coef={S3J['系数']['风险转化能力']['coef']:.5f}，"
    f"t={S3J['系数']['风险转化能力']['t']:+.2f}；"
    f"单维 R²={S3['风险转化能力']['r2']:.4f}；"
    f"样本外（{DG['D2_样本外']['切分点']} 前算指标、后算 alpha）"
    f"单维 t={DG['D2_样本外']['单维']['风险转化能力']['t']:+.2f}"
    f"（p={DG['D2_样本外']['单维']['风险转化能力']['p']:.4f}）、"
    f"联立 t={DG['D2_样本外']['联立']['系数']['风险转化能力']['t']:+.2f}；"
    f"换用季度原始收益 t={DG['D4_换因变量']['风险转化能力']['t']:+.2f}",
    f"存在部分定义同源：与因变量最大相关 {DG['D1_定义重叠']['L4b最大']:.3f}"
    f"（对照组最高 {DG['D1_定义重叠']['其余最大']:.3f}）；"
    f"增量 R²={DG['D3_剔除L4b']['增量R2']:.4f} 中有一部分来自定义重叠。"
    f"跨期检验是其有效性的主要依据，性质弱于纯行为维度。",
    '论文 3.5 之二 ｜ 方法详解 §4.10 ｜ 画像 3.8')

add('D3', 'L1 基本面优势',
    '它是业绩的边界条件而非能力本身：决定可能性上限，不决定结果。',
    f"单维 t={S3['基本面优势']['t']:+.2f}（p={S3['基本面优势']['p']:.4f}）；"
    f"同期联立 t={S3J['系数']['基本面优势']['t']:+.2f}（不显著）；"
    f"样本外联立转为显著为正 "
    f"t={DG['D2_样本外']['联立']['系数']['基本面优势']['t']:+.2f}"
    f"（p={DG['D2_样本外']['联立']['系数']['基本面优势']['p']:.4f}）；"
    f"与风险应对相关 {S2['基本面优势']['风险应对能力']:.3f}、"
    f"与交易执行相关 {S2['基本面优势']['交易执行能力']:.3f}",
    f"典型反例：{_l1_arch['基金简称']} L1 分位 "
    f"{_l1_arch['六维分位']['基本面优势']:.1%}（几乎最高），"
    f"但认知分位 {_l1_arch['六维分位']['认知能力']:.1%}、"
    f"风险转化 {_l1_arch['六维分位']['风险转化能力']:.1%}，"
    f"FF5 alpha 为 {_l1_arch['ff5_alpha']:.2%}（负值）。",
    '论文 3.4／3.5 之三 ｜ 方法详解 §0／§4.10 ｜ 画像 1.4／3.8')

add('D4', 'L5 交易执行',
    '单维有效但独立解释力被 L4a 过程应对吸收，不宜单独强调；'
    '这不是它无效，而是两者共用了一部分信号。',
    f"单维 t={S3['交易执行能力']['t']:+.2f}（p={S3['交易执行能力']['p']:.4f}）；"
    f"同期联立 t={S3J['系数']['交易执行能力']['t']:+.2f}；"
    f"样本外联立 t={DG['D2_样本外']['联立']['系数']['交易执行能力']['t']:+.2f}；"
    f"与风险应对相关 {S2['交易执行能力']['风险应对能力']:.3f}；"
    f"成分级相关 SDI×ARG={CH['关键跨层相关']['ARG_x_SDI']:+.3f}"
    f"（远高于维度级相关 {S2['交易执行能力']['风险应对能力']:.3f}）",
    '两个口径下均不显著，结论一致——不是时序错位造成的假象。'
    f'成分层面，SDI 与 L4a 的 ARG 相关 {CH["关键跨层相关"]["ARG_x_SDI"]:+.3f}：'
    '「基金收益偏离静态持仓的幅度」越大者，「净值风格漂移」反而越小，'
    '两者近乎同一构念的两端；L5 的独立解释力主要因此被 L4a 吸收。',
    '论文 3.4 ｜ 方法详解 §4.8 ｜ 画像 3.5／五')

add('D5', 'L2 认知能力',
    '认知层是最稳定的行为来源：三个成分方向均显著且稳定，'
    '联立与样本外均保持显著（各成分的文献依据与方向口径见限定）。',
    f"单维 t={S3['认知能力']['t']:+.2f}，R²={S3['认知能力']['r2']:.4f}；"
    f"联立 t={S3J['系数']['认知能力']['t']:+.2f}；"
    f"成分定向（单变量相关 t，与论文表 4 含三控制变量的回归 t 口径不同）："
    f"risk_asym {S1['risk_asym']['t']:+.2f}、"
    f"de {S1['de']['t']:+.2f}、oc_conf {S1['oc_conf']['t']:+.2f}；"
    f"群体画像差值 t={GP['六维']['t']['认知能力']:+.2f}（六维中最高）；"
    f"样本外联立 t={DG['D2_样本外']['联立']['系数']['认知能力']['t']:+.2f}"
    f"（p={DG['D2_样本外']['联立']['系数']['认知能力']['p']:.4f}）",
    f'理论口径须说明一处：risk_asym 的度量思路源自 Ang, Chen & Xing (2006) 的下行风险定价，'
    f'而非前景理论的偏差检验。前景理论预测「亏损期 risk-seeking」（σ(亏损) > σ(盈利)）；'
    f'本样本 risk_asym 有 {CH["risk_asym方向检验"]["正值占比"]:.1%} 的观测为正且正向显著，'
    '即「盈利期进攻、亏损期防守」者业绩更好，与前景理论的偏差方向相反。'
    '故 risk_asym 在本研究中应理解为「压缩下行波动的能力」（有利特征），'
    'L2 中严格意义的认知偏差是 de 与 oc_conf 两个成分。',
    '论文 3.4 ｜ 方法详解 §3／§5.1 ｜ 画像 3.5／4.1')

add('D6', 'L3 配置选择',
    '敢于集中押注行业、且不频繁漂移的经理业绩更好。',
    f"单维 t={S3['配置选择能力']['t']:+.2f}，R²={S3['配置选择能力']['r2']:.4f}；"
    f"联立 t={S3J['系数']['配置选择能力']['t']:+.2f}；"
    f"成分定向（单变量相关 t）：ICI {S1['ICI']['t']:+.2f}、ISDI {S1['ISDI']['t']:+.2f}；"
    f"样本外联立 t={DG['D2_样本外']['联立']['系数']['配置选择能力']['t']:+.2f}"
    f"（p={DG['D2_样本外']['联立']['系数']['配置选择能力']['p']:.4f}）",
    '', '论文 3.4 ｜ 方法详解 §3／§5.1 ｜ 画像 3.5')

add('D7', 'L4a 过程应对',
    '面对市场冲击的主动行为（持仓外调仓贡献、下跌时收缩暴露）显著提升业绩，'
    '样本外联立系数为六维最高；但其 timing 成分同样由收益序列估计，与因变量存在'
