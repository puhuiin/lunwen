    ['CFA 资格\nhas_CFA',
     '资格认证能否转化为业绩技能',
     'Chevalier & Ellison (1999)',
     'has_CFA = 1(经理持有 CFA)',
     '仅 9 人持证，样本过小，未纳入'],
    ['学历\nmaster_up',
     '教育水平作为人力资本的代理变量',
     'Chevalier & Ellison (1999)',
     'master_up = 1(硕士及以上)',
     '剔除缺失后与业绩无稳定关系，未纳入'],
    ['院校层次\ntop_school',
     '名校背景所含的信息网络与筛选效应',
     'Chevalier & Ellison (1999)',
     'top_school = 1(本科属重点高校)',
     '覆盖率 41.8%，三口径不显著，未纳入'],
    # ---- 认知与行为偏差 ----
    ['风险偏好不对称\nrisk_asym',
     '风险态度随盈亏状态改变',
     'Kahneman & Tversky (1979)\nAng, Chen & Xing (2006)',
     'risk_asym = σ(盈利季超额) − σ(亏损季超额)，滚动 8 季',
     '盈时进攻、亏时防守'],
    ['处置效应\nde',
     '售盈持亏倾向有损收益',
     'Shefrin & Statman (1985)\nOdean (1998)',
     'de = PGR − PLR；PGR/PLR = 已实现盈利(损) ÷ (已实现盈利(损) + 账面盈利(损))',
     '越倾向售盈持亏；越负（止损越果断）alpha 越高'],
    ['过度自信\noc_conf',
     '业绩向好后的自我归因偏差引发过度交易',
     'Gervais & Odean (2001)\nPuetz & Ruenzi (2011)',
     'oc_conf = (TO_t − TO_{t−1}) × 1(R_{t−1} > 0)',
     '盈利后加码交易越明显'],
    ['追涨杀跌\nrc_mom',
     '基于近期涨幅追买的趋势外推偏差',
     'Greenwood & Shleifer (2014)',
     'rc_mom = corr(权重变动，个股前 12 月收益)',
     '越追逐涨幅。仅 FF3 显著，未纳入'],
    ['锚定效应\nanchor_high',
     '以历史最高价为参考点',
     '池丽旭、庄新田 (2011)\nGrinblatt & Han (2005)',
     'anchor_high = Σ_i w_i × (P_i,t ÷ max P_i,过去36月)',
     '持仓越接近历史高点'],
    ['资本利得悬垂\ncgo',
     '账面盈亏位置决定卖出压力',
     'Grinblatt & Han (2005)',
     'cgo = Σ_i w_i × (P_i,t − RefP) ÷ RefP；RefP 为 12 月均价',
     '持仓账面盈利越厚'],
    ['私房钱效应\nhouse_money',
     '前期盈利后风险承担意愿上升',
     '池丽旭、庄新田 (2011)',
     'house_money = 1(R_{t−1} > 0)\n × (σ_t − σ_{t−1})',
     '盈利后加大风险暴露。FF5 不显著，未纳入'],
    ['羊群方向不对称\nbhm_shm',
     '买入羊群与卖出羊群的强度差异',
     'Wermers (1999)',
     'bhm_shm = 买入羊群度 − 卖出羊群度（LSV 分方向）',
     '跟买强于跟卖。三口径不显著，未纳入'],
    # ---- 配置与选择 ----
    ['行业集中度\nICI',
     '集中押注体现私有信息，业绩更优',
     'Kacperczyk et al. (2005)',
     'ICI = Σ_j (w_j − w̄_j)²；j 为申万 31 一级行业，w̄ 为市场均值',
     '行业配置越偏市场、押注越集中'],
    ['行业风格漂移\nISDI',
     '频繁切换抬高成本、分散信息优势',
     'Chen & Wei (2025)',
     'ISDI = Σ_g |w_g,t − w_g,t−1|；g 为高/中/低行业 Beta 三组',
     '行业弹性结构变动越频繁'],
    ['改进主动份额\nAS_improved',
     '持仓偏离度能否代表主动管理能力',
     'Cremers & Petajisto (2009)\nFrazzini et al. (2016)',
     'AS = ½ Σ_i |w_i,基金 − w_i,基准|，基准为沪深 300',
     '持仓越偏离基准。符号翻转，未纳入'],
    # ---- 风险应对 ----
    ['调仓幅度\nARG',
     '定期披露之外的调仓操作预示未来业绩',
     'Kacperczyk et al. (2008)',
     'ARG = Σ_{月∈季} |R_基金,t − Σ_i w_i,期初 R_i,t|',
     '披露外收益越多、操作越密'],
    ['下行保护\ntiming',
     '市场下跌时主动收缩暴露的择时能力',
     'Henriksson & Merton (1981)\nTreynor & Mazuy (1966)',
     'ex_t = a + b·MKT_t + γ·min(0, MKT_t)；timing = −γ（≥12 季）',
     'γ<0 即跌市额外下跌，timing 越大保护越好'],
    ['收益波动率\nreturn_volatility',
     '风险承担水平本身对超额收益的解释力',
     'Brown, Harlow & Starks (1996)',
     'σ(季度超额收益)，滚动 8 季',
     '三口径显著为正，属风险暴露而非能力，未纳入'],
    ['风险稳定性\nrsstab',
     '风险水平在期间是否保持稳定',
     'Brown, Harlow & Starks (1996)',
     '−|σ_4季,t − σ_4季,t−1|（滞后一期）',
     '风险越稳定；与收益波动率相关 −0.75，正交化后不显著，未纳入'],
    ['Sharpe 比率\nsharpe8',
     '单位总风险的收益转化效率',
     'Sharpe (1966)',
     'sharpe8 = mean(ex) ÷ σ(ex)，滚动 8 季、滞后；ex = 季超额 − rf',
     '总风险收益转化效率越高'],
    ['Sortino 比率\nsortino8',
     '真正厌恶的是下行风险而非总波动',
     'Sortino & Price (1994)',
     'sortino8 = mean(ex) ÷ σ(ex | ex<0)，滚动 8 季、滞后；亏损季 ≥3 且下行波动 >1%，否则缺失',
     '下行风险收益转化效率越高'],
    ['抗操纵绩效测度\nmppm8',
     '传统比率可被极端暴露操纵，需效用变换度量',
     'Goetzmann et al. (2007)',
     'mppm8 = ln[ mean((1+R)÷(1+rf))^{1−ρ} ] ÷ [(1−ρ)·Δt]；ρ=3，Δt=0.25 季',
     '效用增长越高、越不易被彩票型收益操纵'],
    # ---- 交易执行 ----
    ['策略偏离指数\nSDI',
     '风格漂移影响基金业绩与资金流',
     'Wermers (2012)',
     '8 季滚动风格回归 R ~ 四风格指数；SDI = Σ_k |β_k,t − β_k,t−1|',
     '净值层面风格漂移越剧烈'],
    ['交易趋同度\nlsv',
     '被共识买入的股票随后跑赢',
     'Lakonishok et al. (1992)\nWermers (1999)',
     'lsv = mean_i( |p_i,t − p̄_t| − AF_i,t )；p＝买入 i 的基金数占比，AF 为零羊群期望',
     '买卖方向与同业越趋同'],
    ['换手率\nTO',
     '交易频率与业绩的关系',
     'Puetz & Ruenzi (2011)',
     'TO = 季度双边成交额 ÷ 平均资产净值',
     '交易越频繁。仅 FF3 显著，未纳入'],
]

# 层级归属（对应提示词要求的「层级」列；内容用本研究的五层框架，不照抄）
LAYER_OF = {
    'tenure': '风格底色', 'log_age': '风格底色', 'log_aum': '风格底色', 'male': '风格底色',
    'has_CFA': '风格底色', 'master_up': '风格底色', 'top_school': '风格底色',
    'risk_asym': '认知偏差', 'de': '认知偏差', 'oc_conf': '认知偏差',
    'rc_mom': '认知偏差', 'anchor_high': '认知偏差', 'cgo': '认知偏差',
    'house_money': '认知偏差', 'bhm_shm': '认知偏差',
    'ICI': '风格底色', 'ISDI': '风格底色', 'AS_improved': '风格底色',
    'ARG': '风险应对', 'timing': '风险应对', 'return_volatility': '风险应对',
    'rsstab': '风险应对', 'sharpe8': '风险应对', 'sortino8': '风险应对', 'mppm8': '风险应对',
    'SDI': '风险应对', 'lsv': '风险应对', 'TO': '风险应对',
}
_LAYERS = [LAYER_OF.get(r[0].split('\n')[-1], '—') for r in theory_rows]
theory_rows = [[_LAYERS[i]] + r for i, r in enumerate(theory_rows)]

caption(doc, '表 1  三层递进行为框架与候选指标体系')
_t1 = fill_table(doc, ['层级', '指标', '影响渠道', '来源', '计算', '说明与方向'],
                 theory_rows, widths=[1.5, 1.9, 3.2, 2.9, 3.7, 3.8], size=7,
                 left_cols={0, 1, 2, 3, 4, 5})
# 层级列纵向合并：连续同层级只标一次，避免 27 行重复刷屏
_i, _n = 0, len(_LAYERS)
while _i < _n:
    _j = _i
    while _j + 1 < _n and _LAYERS[_j + 1] == _LAYERS[_i]:
        _j += 1
    if _j > _i:
        _t1.cell(_i + 1, 0).vertical_alignment = WD_ALIGN_VERTICAL.CENTER
        for _p in _t1.cell(_i + 1, 0).paragraphs:
            _cell_fmt(_p, WD_ALIGN_PARAGRAPH.CENTER)
    _i = _j + 1
note(doc, '注：w 为持仓权重，σ 为标准差，TO 为换手率，R 为收益率，'
          'MKT 为市场超额收益，P 为个股价格，rf 为无风险利率，1(·) 为指示函数。'
          '实证方向依据第二部分检验结果；「未纳入画像」即检验未通过、不进入计分。')

# ---------------------------------------------------------------- 3 实证检验
heading(doc, '二、实证检验：行为指标的业绩解释力', 1)

heading(doc, '（一）样本与指标设计', 2)
para(doc, '基金净值、持仓与行业配置数据取自 AKShare 与东方财富，换手率取自 Wind。'
          '因变量为 FF5 五因子调整后超额收益（alpha，Fama & French, 2015；'
          '中国市场适用性见李志冰等, 2017）。'
          f"样本覆盖 2006Q3–2026Q2 共 {SC['季度数']} 个季度，"
          f"其中 {SC['可进入横截面回归的基金数']} 只存续 ≥12 个季度，构成横截面回归样本。")


# ---------------------------------------------------------- 表 2 逐年统计性描述
para(doc, '样本是否足够广泛、有没有“只挑了好年景”？逐年结构来回答（表 2）：'
          '2015 年后基金数进入两位数、2020 年后稳定在三百只以上，'
          '存续不少于 12 个季度的 362 只构成横截面回归样本；'
          '2015、2018、2022 三段下跌与 2019–2021 结构性上涨均在样本内——'
          '结论不依赖单一行情。')

_yd_rows = []
for _r in YD['逐年']:
    _to = '—' if _r['平均换手率_单边'] is None else f"{_r['平均换手率_单边']:.0f}"
    _yd_rows.append([_r['年份'], _r['基金数'], f"{_r['平均规模_亿']:.1f}", _to,
                     f"{_r['平均季度收益']:+.2f}", f"{_r['平均超额收益']:+.2f}"])
_sy = YD['全样本']
_yd_rows.append(['全样本', _sy['基金数'], f"{_sy['平均规模_亿']:.1f}",
                 f"{_sy['平均换手率_单边']:.0f}",
                 f"{_sy['平均季度收益']:+.2f}", f"{_sy['平均超额收益']:+.2f}"])
caption(doc, '表 2  样本的逐年分布与统计性描述')
fill_table(doc, ['年份', '基金数', '平均规模\n(亿元)', '平均换手率\n(单边 %)',
                 '平均季度收益\n(%)', '平均超额收益\n(%)'],
           _yd_rows,
           widths=[2.2, 2.2, 3.0, 3.2, 3.2, 3.2], size=8)
note(doc, '注：规模、收益与超额均为「基金—年均值后再跨基金取均值」，每只基金等权；'
          '换手率为 Wind 单边年化（半年频），观测层 1%/99% 缩尾后聚合，'
          '2026 年未更新记「—」；超额收益＝季度收益减沪深 300 收益。'
          '2015 年前基金数不足 30 只，年度指标仅供参照；2026 年仅含前两季。')


DS_CN = DS['描述统计']['中文名']
# 全部研究过指标的中文名（含未入选者与背景哑变量），供矩阵表与三因变量表使用
XCN = dict(DS_CN)
XCN.update({
    'mgr_total_tenure_v2': '任职年限', 'log_fund_age': '基金年龄', 'log_aum': '基金规模',
    'male': '性别（男=1）', 'has_CFA': 'CFA 持证', 'master_up': '硕士及以上', 'top_school': '名校毕业',
    'rc_mom': '追涨杀跌', 'anchor_high': '锚定效应', 'cgo': '资本利得悬垂',
    'house_money': '私房钱效应', 'bhm_shm': '羊群不对称', 'return_volatility': '收益波动率',
    'rsstab_lag': '风险稳定性', 'TO_wind_clean': '换手率', 'AS_improved': '改进主动份额',
})
# 全部候选指标的展示顺序（与表 1 一致）：背景连续 → 背景哑变量 → 行为指标
ALLX = (['mgr_total_tenure_v2', 'log_fund_age', 'log_aum',
         'male', 'has_CFA', 'master_up', 'top_school',
         'risk_asym', 'de', 'oc_conf', 'rc_mom', 'anchor_high', 'cgo', 'house_money', 'bhm_shm',
         'ICI', 'ISDI', 'AS_improved',
         'ARG', 'timing', 'return_volatility', 'rsstab_lag',
         'sharpe8_lag', 'sortino8_lag', 'mppm8_lag',
         'SDI', 'lsv', 'TO_wind_clean'])
_DUMMY_X = {'male', 'has_CFA', 'master_up', 'top_school'}
_L1_X = {'mgr_total_tenure_v2', 'log_fund_age', 'log_aum'}


def _uv(x, dv='ff5_alpha'):
    """候选指标 x 的基金层单变量 OLS 回归结果（无控制，t/p/n/R²）。"""
    return UV['结果'][x][dv]['裸回归']


def _tt(v):
    """带符号 t 值与显著性星号。"""
    if v is None:
        return '—'
    return f"{v['t']:+.1f}{star(v['p'])}"

# -*- coding: utf-8 -*-
# 片段：新「（二）检验结果 + （三）维度归并」，由 _splice_empirical_20260902.py 拼入主脚本。

heading(doc, '（二）检验结果', 2)

para(doc, '检验分三步。第一步<b>单变量回归</b>：表 1 中每个候选指标'
          '（含背景哑变量）单独对 FF5 alpha 回归，不预设分层与显著性。'
          '第二步<b>因变量口径对照</b>：换 FF3 与 FF5 调整收益，检验是否依赖特定基准。'
          '第三步<b>联立回归</b>：连续型指标同入一方程识别净效应；'
          '背景哑变量缺失较多，只在单变量口径考察。'
          '检验完成后才归并能力维度（本部分之三）。')


# ---------------------------------------------------------- 式（1）单变量回归
para(doc, '单变量回归采用基金层横截面 OLS，方程为：')
equation(doc,
    _sub(_run('FF5α'), _run('i')) + _run(' = ', 'p') + _run('c')
    + _run(' + ', 'p') + _sub(_run('β'), _run('k'))
    + _run(' · ', 'p') + _sub(_run('X'), _run('k,i'))
    + _run(' + ', 'p') + _sub(_run('u'), _run('i'))
    + _run('，  k = 1, 2, …', 'p'),
    align=WD_ALIGN_PARAGRAPH.CENTER)
para(doc, '其中 Y 为基金全样本期 FF5 回归截距（剥离五种风格暴露后的超额收益），'
          'X_k 为基金内时序均值（1%/99% 缩尾，业绩类滞后一期），β_k 以 HC1 稳健标准误检验。'
          '每次只放一个指标、不含控制变量——背景变量同样受检。')


# ---------------------------------------------------------- 式（2）联立回归
para(doc, '联立回归把全部连续型候选指标同时放入同一方程：')
equation(doc,
    _sub(_run('FF5α'), _run('i')) + _run(' = ', 'p') + _run('c')
    + _run(' + ', 'p')
    + _nary('∑', _run('k') + _run(' = 1', 'p'), _run('K'),
            _sub(_run('β'), _run('k')) + _run(' · ', 'p')
            + _sub(_run('X'), _run('k,i')))
    + _run(' + ', 'p') + _sub(_run('u'), _run('i')),
    align=WD_ALIGN_PARAGRAPH.CENTER)
# ---------------------------------------------------------- 表 3 单变量回归结果
_uv_rows = []
for x in ALLX:
    _ub = UV['结果'][x]['ff5_alpha']['裸回归']
    _uv_rows.append([XCN.get(x, x), fmt(_ub['b'], 4),
                     f"{_ub['t']:+.2f}{star(_ub['p'])}",
                     f"{_ub['r2']:.3f}"])
caption(doc, '表 3  全部候选指标的单变量回归结果（因变量＝FF5 alpha；联立净效应见正文）')
fill_table(doc, ['指标', '单变量系数', '单变量 t', 'R²'],
           _uv_rows, widths=[6.0, 3.6, 3.0, 4.4], size=8.5,
           left_cols={0})
note(doc, '注：单变量为式（1）——每次只放一个指标、不含控制变量，背景变量同样受检；'
          '「联立」为式（2）的净效应 t 值。***、**、* 为 1%、5%、10% 显著。'
          '背景哑变量与覆盖率不足者不入联立，记「—」；N=355–362。系数不可跨指标比，可比的是 t 值。')

# ---------------------------------------------------------- 经济解释（指标层面）
_SD = DS['描述统计']['std']
_econ = {
    'de': abs(UV['结果']['de']['ff5_alpha']['裸回归']['b'] * _SD['de']) * 100,
    'ICI': UV['结果']['ICI']['ff5_alpha']['裸回归']['b'] * _SD['ICI'] * 100,
    'sharpe': UV['结果']['sharpe8_lag']['ff5_alpha']['裸回归']['b'] * _SD['sharpe8_lag'] * 100,
}
para(doc, 't 值回答“是否显著”，系数回答“值多少钱”。各指标量纲不同，'
          '系数乘以样本标准差、换算为“每提高一个标准差”的收益变动后即可比较：'
          f"处置效应每高 1 个标准差，季度 FF5 alpha 下降 {_econ['de']:.2f} 个百分点，"
          f"行业集中度上升 {_econ['ICI']:.2f}、Sharpe 上升 {_econ['sharpe']:.2f} 个百分点；"
          f"年化约 −{_econ['de'] * 4:.1f}%、+{_econ['ICI'] * 4:.1f}%、+{_econ['sharpe'] * 4:.1f}%。"
          '参照系是样本季度 FF5 alpha 均值 '
          f"{DS['描述统计']['mean']['ff5_adj_return'] * 100:.2f}%——"
          '处置效应恶化一个标准差即吞掉约四分之一；'
          '量级可观而显著者才作结论依据。')

# ---------------------------------------------------------- 关键因素识别段
_uv5 = lambda x: UV['结果'][x]['ff5_alpha']['裸回归']
_uvc = lambda x: UV['结果'][x]['ff5_alpha'].get('加控制') or UV['结果'][x]['ff5_alpha']['裸回归']
para(doc, f"28 个候选里，13 个行为指标在横截面口径下全部显著，方向与预期一致——"
          f"集中押注（ICI）、盈时加码（risk_asym）、报表外动作（ARG）、熊市防守（timing）"
          f"与三比率（MPPM/Sortino/Sharpe）显著为正，处置效应（de）、过度自信（oc_conf）、"
          f"风格漂移（ISDI）显著为负，锚定效应同样过关——“死守高点”损害收益；"
          f"具体 t 值见表 3。"
          f"三个基本面指标方向全部为负，与“职业关注激励”及“规模不经济”（Berk & Green, 2004）"
          f"预期一致。<b>不显著的一侧同样整齐</b>：换手率、主动份额、追涨杀跌、羊群不对称"
          f"及背景变量——CFA 显著但持证者仅 9 人，不足为据。联立后 ARG、timing、MPPM、ICI "
          f"净效应稳固，其余因相互吸收而回落——归并以单变量方向为准（见本部分之三）。")

# ---------------------------------------------------------- 表 3 三因变量对照
_dv_rows = []
for x in ALLX:
    r = UV['结果'][x]
    _dv_rows.append([XCN.get(x, x),
                     _tt(r['ex_hs300']['裸回归']),
                     _tt(r['ff3_alpha']['裸回归']),
                     _tt(r['ff5_alpha']['裸回归'])])
caption(doc, '表 4  因变量口径对照：三种超额收益度量下的单变量回归')
fill_table(doc, ['指标', '超额收益（对沪深300）', 'FF3 alpha', 'FF5 alpha'],
           _dv_rows, widths=[4.1, 4.3, 4.3, 4.3], size=8, left_cols={0})
note(doc, '注：单元格为基金层横截面 OLS 的 t 值与显著性；三列回归样本随因变量覆盖率微调'
          '（N≈352–362）。简单超额不剔因子、风格暴露留在残差，仅作参照。')

para(doc, '切换因变量揭示两类信息。其一，<b>稳健真信号</b>：13 个指标三口径'
          '方向与显著性完全一致，是归并主力。'
          f"其二，<b>风格伪信号</b>：私房钱效应在简单超额口径显著"
          f"（t={UV['结果']['house_money']['ex_hs300']['裸回归']['t']:+.2f}），"
          f"换 FF5 后降至 t={UV['结果']['house_money']['ff5_alpha']['裸回归']['t']:+.2f}，"
          '只是风格暴露的镜像；反如下行保护，简单超额口径仅 '
          f"t={UV['结果']['timing']['ex_hs300']['裸回归']['t']:+.2f}、"
          f"剔因子后升至 {UV['结果']['timing']['ff5_alpha']['裸回归']['t']:+.2f}——"
          '被风格噪声掩盖的真信号。「三口径方向一致且显著」遂成入选门槛。')


# ---------------------------------------------------------------- （三）维度归并
heading(doc, '（三）维度复合与业绩预测', 2)

para(doc, '通过筛选的指标先做横截面 z 标准化、按表 1 实证方向定向，再复合为能力得分——'
          '风险应对层拆为过程应对与转化效率两维，实得六维：'
          '<b>风险转化能力</b>（三比率）、'
          '<b>风险应对能力</b>（调仓幅度、下行保护）、'
          '<b>认知能力</b>（风险偏好不对称、处置效应、过度自信、锚定效应）、'
          '<b>配置选择能力</b>（行业集中度、行业风格漂移）、'
          '<b>交易执行能力</b>（风格漂移、交易趋同）与<b>基本面优势</b>'
          '（任职年限、基金年龄、规模的镜像计分）。维度归并公式为：')

# 式（3）复合公式
equation(doc,
    _sub(_run('Score'), _run('d,i')) + _run(' = ', 'p')
    + _frac(_run('1', 'p'), _sub(_run('n'), _run('d')))
    + _nary('∑', _run('j ∈ d'), None,
            _sub(_run('s'), _run('j')) + _run(' · ', 'p')
            + _run('z', 'p') + _run('(', 'p') + _sub(_run('X'), _run('j,i'))
            + _run(')', 'p')),
    align=WD_ALIGN_PARAGRAPH.CENTER)
para(doc, '其中 s_j 为定向符号（取自表 1 实证方向），'
          'z(·) 为横截面标准化，n_d 为维度内有值成分数——缺失不填 0，'
          '“算不出 Sortino”的基金不会被数据可得性压低；'
          '维度内等权避免单成分主导，六维等权复合为综合能力分；'
          '风险应对拆为过程与转化两维，实得 2/6≈1/3 权重。'
          '锚定效应并入认知维度；资本利得悬垂虽过三道门槛，'
          '但与锚定效应相关 0.63，为避免重复计分留档备索。')

para(doc, '把六个维度得分同时放入回归（主回归方程）：')
# 式（4）主回归
equation(doc,
    _sub(_run('FF5α'), _run('i')) + _run(' = ', 'p') + _run('c')
    + _run(' + ', 'p')
    + _nary('∑', _run('d') + _run(' = 1', 'p'), _run('6'),
            _sub(_run('β'), _run('d')) + _run(' · ', 'p')
            + _sub(_run('Score'), _run('d,i')))
    + _run(' + ', 'p') + _sub(_run('γ'), _run('1')) + _run(' · ', 'p')
    + _sub(_run('tenure'), _run('i'))
    + _run(' + ', 'p') + _sub(_run('γ'), _run('2')) + _run(' · ', 'p')
    + _sub(_run('log_age'), _run('i'))
    + _run(' + ', 'p') + _sub(_run('γ'), _run('3')) + _run(' · ', 'p')
    + _sub(_run('log_aum'), _run('i'))
    + _run(' + ', 'p') + _sub(_run('u'), _run('i')),
    align=WD_ALIGN_PARAGRAPH.CENTER)
para(doc, '六个得分均为 z 分尺度，β_d 可横向比较；联立中 β_d 即净效应——'
          '交易执行与基本面优势转不显著，是信号被相关性最高的维度吸收'
          '（净效应消失不等于无效，单维结果见表 6）。'
          f"维度间相关最高 {max(max(v.values()) for v in CP['S2_维度相关'].values()):.3f}、"
          f"最低 {min(min(v.values()) for v in CP['S2_维度相关'].values()):.3f}，无严重共线（图 1）。")
add_figure(doc, '论文图2_维度相关热力图.png',
           '图 1  六个能力维度的两两相关系数热力图')


cp_rows = []
for d in DIM_ORDER:
    u = CP['S3_单维'][d]
    j = CP['S3_联立']['系数'][d]
    cp_rows.append([d, fmt(u['coef']), f"{u['t']:.2f}{star(u['p'])}", fmt(u['r2'], 4),
                    fmt(j['coef']), f"{j['t']:.2f}{star(j['p'])}"])
u = CP['S3_单维']['综合能力']
cp_rows.append(['综合能力', fmt(u['coef']), f"{u['t']:.2f}{star(u['p'])}", fmt(u['r2'], 4), '—', '—'])
caption(doc, '表 5  能力维度得分对 FF5 alpha 的回归')
fill_table(doc, ['维度', '单维系数', '单维 t', '单维 R²', '联立系数', '联立 t'],
           cp_rows, widths=[3.6, 2.6, 2.4, 2.4, 2.6, 2.4], size=8.5, left_cols={0})
note(doc, f"注：单维回归中基本面优势为三控制变量本身（无控制），"
          '其余五维含三控制变量；HC1 稳健标准误。'
          f"联立模型 N={CP['S3_联立']['n']}，R²={CP['S3_联立']['r2']:.4f}，"
          '不叠加控制变量（基本面优势得分是三控制变量的线性组合，叠加即完全共线）；'
          f"对照口径「五维联立＋三控制变量」R²={CP['S3_联立_五维对照']['r2']:.4f}，信息含量相当。"
          '风险转化三比率与因变量概念同源（同为收益序列构造），其解释力部分来自构造相关性，'
