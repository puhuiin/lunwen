fill_table(doc, ['能力维度', 'Top5% 均值', 'Bottom5% 均值', '差值', 't 值'],
           dim_rows, widths=[4.6, 3.2, 3.2, 3.0, 3.0], size=8.5, left_cols={0})
note(doc, '注：单指标中区分度最高的是下行保护系数'
          f"（t={GP['原始指标']['t']['timing']:+.2f}）——最能拉开差距的行为不是选股，"
          '而是市场下跌时是否主动收缩暴露；其余显著分化的原始指标明细备索。')

bg_rows = []
for i, q in enumerate(['Q1最低', 'Q2', 'Q3', 'Q4', 'Q5最高']):
    _pa = PA['五分组'][q]
    bg_rows.append([f'Q{i+1}', f"{BF['n'][q]}", fmt(BF['综合能力'][q]),
                    f"{BF['ff5_alpha'][q]:.2%}", f"{BF['季度收益'][q]:.2%}",
                    f"{BF['规模亿'][q]:.1f}", f"{_pa['背景覆盖率']:.0%}",
                    f"{_pa['硕士以上_有效分母']:.0%}",
                    f"{_pa['CFA_有效分母']:.0%}"])
caption(doc, '表 9  综合能力五分组背景（Q1 最低 → Q5 最高）')
fill_table(doc, ['分组', 'N', '综合能力', 'FF5 alpha', '季度收益', '规模(亿)',
                 '背景覆盖', '硕士以上', 'CFA'],
           bg_rows, widths=[1.5, 1.3, 2.2, 2.2, 2.2, 2.0, 1.9, 1.9, 1.8], size=8.5)
note(doc, '注：规模为组内中位数（均值受少数巨型基金影响）。'
          '背景覆盖为该组学历／CFA 数据可得比例；'
          '硕士以上与 CFA 占比以该组有效样本为分母，'
          '不将缺失计入非持有——因覆盖率本身与能力得分显著负相关，'
          '按全组人数为分母会产生学历随能力下降的假趋势。')

heading(doc, '（二）典型案例：六种行为切面', 2)
para(doc, '数字看群体，案例看个体。我们从全样本挑了 6 位经理（按姓名去重），'
          '故意挑“极端代表”：综合能力 100 分位的全能型、转化效率 100 分位的风险定价型、'
          '认知 100 分位的认知纪律型、过程应对 99 分位的攻守转换型、'
          '基本面 100 分位的基本面优势型，'
          '外加综合能力 0 分位的反例（华安策略优选·杨明）。'
          '要回答的问题是：单一维度做到极致，能否撑起好业绩？')
_ORD_SHORT = {'基本面优势': '基本面', '认知能力': '认知', '配置选择能力': '配置',
              '风险应对能力': '应对', '风险转化能力': '转化', '交易执行能力': '交易'}
arch_rows = []
for c in PT['典型画像']:
    pct = ' ／ '.join(
        f'{_ORD_SHORT[d]} {c["六维分位"][d]:.0%}'
        for d in DIM_ORDER if c['六维分位'].get(d) is not None)
    arch_rows.append([
        c['标签'].replace('：', '\n'),
        f"{c['基金简称']}\n{c['经理']}｜{c['公司']}",
        f"{c['规模亿']:.2f}",
        f"{c['ff5_alpha']:.2%}",
        f"{c['综合能力']:+.2f}\n（{c['综合能力分位']:.0%}）",
        pct])
caption(doc, '表 10  典型画像：五名正向画像 + 一名反例的六维分位')
fill_table(doc, ['形态', '基金／经理／公司', '规模\n(亿)', 'FF5\nalpha', '综合能力\n(分位)',
                 '六维分位（基本面／认知／配置／应对／转化／交易）'],
           arch_rows, widths=[2.6, 3.8, 1.4, 1.5, 1.9, 5.8], size=7.5,
           left_cols={0, 1, 5})
note(doc, '注：分位为全样本 400 只基金中的百分位。案例按能力维度极值（非业绩极值）选取——'
          '反例为能力得分最低者，其业绩并非全样本最差，不宜据此质疑能力与业绩的关系。')
_tcs = PT['典型画像']  # 顺序：全能 / 风险定价 / 认知纪律 / 攻守转换 / 基本面 / 反例
para(doc, '图 3 是这六位经理的六维能力雷达图（数值是全样本百分位）。怎么读这张图？'
          '第一，六个角均衡往外扩（全能型那样），代表各层面协同、没有短板；'
          '第二，一个角特别凸、其他角塌下去（认知纪律型、攻守转换型那样）——单一维度的极致；'
          '第三，基本面优势分位高不等于能力强——年轻、小规模是“边界条件”，不是“能力本身”。')
para(doc, f"案例告诉我们两条规律。其一，单一维度的极致撑不起好业绩："
          f"认知纪律型（{_tcs[2]['基金简称'][:4]}）认知满分但过程应对只有 "
          f"{_tcs[2]['六维分位']['风险应对能力']:.0%}，“脑子清醒、手上没动作”，"
          f"综合能力只排 {_tcs[2]['综合能力分位']:.0%}；"
          f"攻守转换型（{_tcs[3]['基金简称'][:6]}）动作多"
          f"（{_tcs[3]['六维分位']['风险应对能力']:.0%}）但转化效率只有 "
          f"{_tcs[3]['六维分位']['风险转化能力']:.0%}，赚到的没留住；"
          f"基本面优势型（{_tcs[4]['基金简称'][:6]}）边界满分但 alpha 为负——"
          "年轻和小规模只是给了机会，不等于会用。"
          "其二，绩优形态（全能型、风险定价型）至少三维同时高位，反例全面塌陷。"
          "行为优势是多维协同的结果，而非单一维度的极致。")
add_figure(doc, '论文图3_典型经理雷达图.png',
           '图 3  五名典型经理与反例（华安策略优选·杨明）六维雷达图（数值为全样本百分位）',
           width_cm=17.0)

# ---------------------------------------------------------------- 3(三) 结论
heading(doc, '四、结论与启示', 1)
para(doc, f"本文以 {SC['基金数']} 只中国主动权益基金、{SC['季度数']} 个季度为样本，"
          "把 28 个候选行为指标放上统一的检验台，"
          "通过显著性检验的 16 个成分归并为六个能力维度刻画投资经理画像。主要结论有四。")
para(doc, '第一，<b>行为优势是全链条的</b>。三层行为需协同作用，'
          '才能在业绩中体现为持续的超额收益；任何单一维度的极端表现均无法独立解释业绩分化。'
          '评价应避免“单指标崇拜”，宜采用多维度复合视角。')
para(doc, '第二，<b>风险应对层是行为转化为业绩的关键枢纽</b>。'
          f"过程应对在群体画像中差距最大（{GP['六维']['差值']['风险应对能力']:.2f}，"
          f"t={GP['六维']['t']['风险应对能力']:.2f}），"
          f"转化效率在联立回归中系数最大（β={_JL['风险转化能力']['coef']:.4f}，"
          f"t={_JL['风险转化能力']['t']:.2f}），"
          f"下行保护的单指标区分度最高（t={GP['原始指标']['t']['timing']:+.2f}）。"
          '能在跌市主动收缩暴露、并把风险高效转化为收益的经理更可能持续跑赢——'
          '“防守能力”应作为评价与风控的重要观察维度。')
para(doc, '第三，<b>基本面边界是边界条件而非能力</b>。任职年限、基金年龄与规模在单变量检验中显著，'
          f"但同期进入联立模型后不显著（t={CP['S3_联立']['系数']['基本面优势']['t']:+.2f}），"
          f"样本外检验转为显著为正（t={DG['D2_样本外']['联立']['系数']['基本面优势']['t']:+.2f}）——"
          '年轻、小规模基金预示后期更高的 alpha，其信息已被行为维度吸收。'
          '规模与任职期限宜作筛选的约束条件而非核心标准。')
para(doc, '第四，<b>行为复合得分具有筛选与自检价值</b>。按综合能力五等分，'
          f"FF5 alpha 自 Q1 的 {_s4['alpha均值']['Q1最低']:.2%} 严格单调升至 Q5 的 "
          f"{_s4['alpha均值']['Q5最高']:.2%}"
          f"（Q5−Q1={_s4['Q5_Q1'] * 100:.2f} 个百分点，t={_s4['t']:.2f}）；"
          f"剔除与因变量同源的转化效率维度后，纯行为三维分组差仍显著"
          f"（{AUD_S['组合']['纯行为L2L3L5']['差'] * 100:.2f} 个百分点，"
          f"t={AUD_S['组合']['纯行为L2L3L5']['t']:+.2f}）。"
          '能力得分可用于经理行为自检与梯队建设；样本仅含存续基金，存在幸存者偏差。')
para(doc, '回到开头那个问题——你是什么样的投资者？'
          '也许答案不在你买了什么，而在你“怎么做决定”：'
          '敢不敢集中、能不能止损、跌市守不守得住。行为，才是业绩的底色。')

# ---------------------------------------------------------------- 附注：方法说明
# 样本式文献处理：正文作者-年份制，文末附注列举主要来源（完整列表联系作者）
p = doc.add_paragraph()
r = p.add_run('附注：方法说明')
set_run(r, size=10.5, bold=True, cn='黑体')
p.paragraph_format.space_before = Pt(14)
p.paragraph_format.space_after = Pt(4)
para(doc, '指标均经 1%/99% 缩尾、z 标准化并按理论定向取号，维度内与六维间均等权复合；'
          '因变量为 FF5 调整后超额收益（Fama & French, 2015；中国市场适用性见李志冰等, 2017）。'
          '本文为工作稿，完整文献列表联系作者。')

REP.mkdir(exist_ok=True)
out_path = REP / '论文初稿_2026-08-31.docx'
