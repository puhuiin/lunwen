  h1{font-size:30px;line-height:1.3;margin:0 0 6px;letter-spacing:.5px}
  h2{font-size:23px;margin:46px 0 14px;padding-bottom:8px;border-bottom:2px solid var(--accent);color:var(--accent)}
  h3{font-size:18.5px;margin:30px 0 10px;color:var(--ink)}
  h4{font-size:16px;margin:22px 0 8px;color:var(--sub)}
  p{margin:11px 0}
  .lead{font-size:16.5px;color:var(--sub);margin:14px 0 22px}
  code{background:var(--soft2);padding:1px 6px;border-radius:5px;font-family:"SFMono-Regular",Consolas,monospace;font-size:13.5px;color:#9a3412}
  .formula{background:var(--soft);border:1px solid var(--line);border-left:4px solid var(--accent);
           padding:14px 18px;margin:16px 0;border-radius:8px;font-family:"SFMono-Regular",Consolas,monospace;
           font-size:15px;line-height:1.95;color:#0b3b24;overflow-x:auto;white-space:pre-wrap;word-break:break-word;
           box-shadow:0 1px 2px rgba(15,23,42,.04)}
